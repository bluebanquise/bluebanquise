#### Blue Banquise file ####
## {{ ansible_managed }}
# Users of every BlueBanquise WebUI pack (bluebanquise_webui_users), read by webui_auth.py at
# every request. Levels: viewer, operator, admin.

users:
{% for user in bluebanquise_webui_users | default([], true) %}
  {{ user['name'] | to_json }}: {"password_hash": {{ user['password_hash'] | to_json }}, "role": {{ user['role'] | to_json }}}
{% endfor %}
