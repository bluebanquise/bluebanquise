#!/usr/lib/bluebanquise/venv/bin/python3
"""
bluebanquise-slurm-api: REST API and WebUI daemon of bluebanquise-slurm: state of the Slurm
nodes, drain and resume.

Runs as the bluebanquise-slurm-api user, which can not run any Slurm command: it reads the state
and the jobs written by the worker (bluebanquise-slurm-worker), and writes requests for it. Its
systemd unit lets it write into the requests folder only.

Served by waitress (production WSGI server). Every request needs HTTP basic authentication, and
the level given to each route in ROUTE_LEVELS (webui_auth.py, users of bluebanquise_webui_users).
Every write action writes an AUDIT line in the journal.

REST API (JSON):
  GET  /api/summary                state of the cluster and of every node (federator contract)
  GET  /api/hosts                  state of every node, counts, CPUs and jobs
  GET  /api/hosts/<host>           state of a node
  GET  /api/hosts/<host>/summary   state of a node (federator contract), plus drained (for Automation)
  POST /api/drain                  {"hosts": "c[001-004]", "reason": "..."}: answers 202 and a job
  POST /api/resume                 {"hosts": "c[001-004]"}: answers 202 and a job
  GET  /api/jobs                   last jobs, the newest first, ?host=<host> for the jobs of a host
  GET  /api/jobs/<job>             state of a job: running, success or failed, and result per node
POST requests must be sent as JSON (Content-Type: application/json): a browser can not send such
a request from another web site (checked by webui_auth.py).

WebUI (Jinja pages, Bulma, plain JavaScript using the REST API):
  GET /              state of every node, drain and resume on a nodeset, last actions
  GET /hosts/<host>  node page
  GET /jobs/<job>    job page: result per node
  GET /static/...    CSS and JavaScript files

The daemon listens on 127.0.0.1 only. Apache serves it under /webui/slurm/ (url_prefix of the
settings): waitress removes this prefix, so the routes above stay as written.
"""

import argparse
import logging
import os
import re
import sys
import threading
import time

from ClusterShell.NodeSet import NodeSet
from flask import Flask, g, jsonify, render_template, request, send_from_directory
from waitress import serve

sys.path.insert(0, '/usr/lib/bluebanquise/bluebanquise-slurm/lib')
import common  # noqa: E402
import webui_auth  # noqa: E402

app = Flask(__name__, static_folder=None)

# Loaded once at startup in main(), the role restarts the service when they change.
settings = None
hosts = None

# Version of the federator contract (summary routes)
CONTRACT = 1

# From the worst to the best, for the state of the cluster
STATES = ['error', 'unknown', 'ok', 'maintenance']

# Characters allowed in a nodeset: names, ranges and lists (c[001-004],login1). No @group, no
# wildcard, no space.
NODESET_CHARACTERS = re.compile(r'^[A-Za-z0-9_.\-\[\],]+$')

# Jobs listed by GET /api/jobs
MAX_JOBS_LISTED = 50

# Taken while checking that no running job holds the hosts of a new job, then writing it
jobs_lock = threading.Lock()

# Who can do what: minimum level (viewer, operator, admin) of each route below, by the name of
# its function. A route missing here is refused to everyone.
ROUTE_LEVELS = {
    # REST API
    'get_summary': 'viewer',
    'get_hosts': 'operator',
    'get_host': 'operator',
    'get_host_summary': 'operator',
    'post_drain': 'operator',
    'post_resume': 'operator',
    'get_jobs': 'operator',
    'get_job': 'operator',
    # WebUI
    'index_page': 'operator',
    'host_page': 'operator',
    'job_page': 'operator',
    'static_file': 'viewer',
}


def error(message, code):
    logging.info('%s %s -> %d %s', request.method, request.path, code, message)
    return jsonify({'error': message}), code


def node_answer(name, node, as_of):
    """A node as the pages see it."""
    state, text, drained = common.node_state(node)
    return {
        'host': name,
        'group': hosts.get(name, {}).get('group', 'none'),
        'slurm_state': node['state'],
        'reason': node['reason'],
        'reason_time': node['reason_time'],
        'partitions': node['partitions'],
        'state': state,
        'text': text,
        'drained': drained,
        'as_of': as_of,
    }


def nodeset_size(text):
    """Number of hosts of a nodeset, counted from its text (c[001-004],login1: 5), or None when
    it can not be counted. ClusterShell keeps every number of a range in memory: c[1-100000000]
    takes gigabytes, so a nodeset is counted before it is given to ClusterShell. Same as
    bluebanquise-operation-api."""
    total = 0
    # Elements are separated by commas outside brackets: c[1-2,5],login1 -> c[1-2,5] and login1
    for element in re.split(r',(?![^\[]*\])', text):
        size = 1
        # Each bracket of an element multiplies its size: r[1-2]c[1-3] gives 6 hosts
        for brackets in re.findall(r'\[([^\]]*)\]', element):
            count = 0
            for part in brackets.split(','):
                numbers = part.split('-')
                if len(numbers) == 1 and numbers[0].isdigit():
                    count = count + 1
                elif len(numbers) == 2 and numbers[0].isdigit() and numbers[1].isdigit():
                    count = count + int(numbers[1]) - int(numbers[0]) + 1
                else:
                    return None
            size = size * count
        total = total + size
    return total


def nodeset_field(data, nodes):
    """The "hosts" field of a request body, as a NodeSet of Slurm nodes. Returns (nodeset, None),
    or (None, error message)."""
    if not isinstance(data.get('hosts'), str) or data['hosts'].strip() == '':
        return None, 'hosts is needed: a node or a nodeset, for example c[001-004]'
    text = data['hosts'].strip()
    if len(text) > 1000 or not NODESET_CHARACTERS.match(text):
        return None, 'hosts must be node names, ranges and lists, for example c[001-004],login1'
    size = nodeset_size(text)
    if size is None:
        return None, 'hosts is not a valid nodeset: {}'.format(text)
    if size > len(nodes):
        return None, 'hosts gives {} nodes, Slurm has {}'.format(size, len(nodes))
    try:
        nodeset = NodeSet(text)
    except Exception as e:
        return None, 'hosts is not a valid nodeset: {}'.format(e)
    unknown = []
    for node in nodeset:
        if node not in nodes:
            unknown.append(node)
    if len(unknown) > 0:
        return None, 'not Slurm nodes: {}'.format(NodeSet.fromlist(unknown))
    return nodeset, None


def start_job(action, nodeset, reason):
    """Write the request of an action, unless a running job already holds one of its nodes.
    Answers 202 and the job, or 409."""
    with jobs_lock:
        busy = []
        for job in common.list_jobs(settings):
            if job['state'] != 'running':
                continue
            for host in common.job_hosts(job):
                if host in nodeset:
                    busy.append(host)
        if len(busy) > 0:
            message = 'Already in a running job, wait for its end: {}'.format(NodeSet.fromlist(busy))
            webui_auth.audit(action, str(nodeset), 'failed', message)
            return error(message, 409)
        job = common.write_request(settings, action, str(nodeset), reason, g.user['name'])

    message = 'Job ' + job['job']
    if reason is not None:
        message = message + ', reason: ' + reason
    webui_auth.audit(action, str(nodeset), 'ok', message)
    return jsonify({
        'job': job['job'],
        'url': 'api/jobs/' + job['job'],
        'message': '{} requested on {}'.format(action, nodeset),
    }), 202


@app.before_request
def check_user():
    """User, password and level of every request (webui_auth.py)."""
    return webui_auth.check_request(ROUTE_LEVELS)


# ─── REST API ───────────────────────────────────────────────────────────────────

@app.route('/api/summary', methods=['GET'])
def get_summary():
    """Federator contract: one call gives the whole cluster map. as_of is the time the worker
    last read the state of the nodes, refresh the seconds between two reads."""
    state = common.read_state(settings)
    hosts_contract = {}
    counts = {'error': 0, 'unknown': 0, 'ok': 0, 'maintenance': 0}
    for name in sorted(state['nodes']):
        node = node_answer(name, state['nodes'][name], state['as_of'])
        hosts_contract[name] = {'state': node['state'], 'text': node['text'], 'url': 'hosts/' + name,
                                'as_of': state['as_of']}
        counts[node['state']] = counts[node['state']] + 1

    # The worst state of a node is the state of the cluster
    cluster_state = 'unknown'
    for contract_state in reversed(STATES):
        if counts[contract_state] > 0:
            cluster_state = contract_state
    texts = []
    for contract_state, label in [('ok', 'ok'), ('maintenance', 'drained'), ('error', 'down'), ('unknown', 'unknown')]:
        if counts[contract_state] > 0:
            texts.append('{} {}'.format(counts[contract_state], label))
    if len(texts) == 0:
        texts.append('no node')
    if state['cpus']:
        texts.append('{}/{} CPUs allocated'.format(state['cpus']['allocated'], state['cpus']['total']))
    if state['jobs']:
        texts.append('{} running, {} pending jobs'.format(state['jobs']['running'], state['jobs']['pending']))
    cluster_text = ', '.join(texts)
    # The worker could not read Slurm: the data gets old, and says why
    if state['error'] is not None:
        cluster_state = 'error'
        cluster_text = 'Slurm not read: ' + state['error']

    as_of = state['as_of']
    if as_of is None:
        as_of = int(time.time())
    return jsonify({
        'contract': CONTRACT,
        'pack': 'slurm',
        'version': settings['version'],
        'as_of': as_of,
        'refresh': settings['refresh_interval'],
        'cluster': {'state': cluster_state, 'text': cluster_text},
        'hosts': hosts_contract,
    })


@app.route('/api/hosts', methods=['GET'])
def get_hosts():
    state = common.read_state(settings)
    answer = []
    counts = {'ok': 0, 'maintenance': 0, 'error': 0, 'unknown': 0}
    for name in sorted(state['nodes']):
        node = node_answer(name, state['nodes'][name], state['as_of'])
        answer.append(node)
        counts[node['state']] = counts[node['state']] + 1
    return jsonify({
        'hosts': answer,
        'counts': counts,
        'cpus': state['cpus'],
        'jobs': state['jobs'],
        'as_of': state['as_of'],
        'error': state['error'],
        'refresh': settings['refresh_interval'],
    })


@app.route('/api/hosts/<hostname>', methods=['GET'])
def get_host(hostname):
    state = common.read_state(settings)
    if hostname not in state['nodes']:
        return error('{} is not a Slurm node'.format(hostname), 404)
    answer = node_answer(hostname, state['nodes'][hostname], state['as_of'])
    answer['refresh'] = settings['refresh_interval']
    answer['error'] = state['error']
    return jsonify(answer)


@app.route('/api/hosts/<hostname>/summary', methods=['GET'])
def get_host_summary(hostname):
    """Federator contract, for one node, plus its Slurm state and reason, and drained: true once
    a drained node has no job left (Automation waits for it)."""
    state = common.read_state(settings)
    if hostname not in state['nodes']:
        return error('{} is not a Slurm node'.format(hostname), 404)
    node = node_answer(hostname, state['nodes'][hostname], state['as_of'])
    return jsonify({
        'contract': CONTRACT,
        'as_of': state['as_of'],
        'refresh': settings['refresh_interval'],
        'state': node['state'],
        'text': node['text'],
        'url': 'hosts/' + hostname,
        'slurm_state': node['slurm_state'],
        'reason': node['reason'],
        'drained': node['drained'],
    })


@app.route('/api/drain', methods=['POST'])
def post_drain():
    data = request.get_json(silent=True)
    if not isinstance(data, dict):
        return error('The body must be a JSON object', 400)
    nodeset, message = nodeset_field(data, common.read_state(settings)['nodes'])
    if nodeset is None:
        return error(message, 400)
    reason = data.get('reason')
    if isinstance(reason, str):
        reason = reason.strip()
    # Slurm gets "[<user>] <reason>", at most common.MAX_REASON characters
    max_length = common.MAX_REASON - len('[{}] '.format(g.user['name']))
    if not common.valid_text(reason, max_length):
        return error('A reason is needed: one line of text, at most {} characters, not starting with "-"'.format(max_length), 400)
    return start_job('drain', nodeset, reason)


@app.route('/api/resume', methods=['POST'])
def post_resume():
    data = request.get_json(silent=True)
    if not isinstance(data, dict):
        return error('The body must be a JSON object', 400)
    nodeset, message = nodeset_field(data, common.read_state(settings)['nodes'])
    if nodeset is None:
        return error(message, 400)
    return start_job('resume', nodeset, None)


@app.route('/api/jobs', methods=['GET'])
def get_jobs():
    hostname = request.args.get('host')
    answer = []
    for job in common.list_jobs(settings):
        if hostname is not None and hostname not in common.job_hosts(job):
            continue
        answer.append(job)
        if len(answer) == MAX_JOBS_LISTED:
            break
    return jsonify({'jobs': answer})


@app.route('/api/jobs/<job_id>', methods=['GET'])
def get_job(job_id):
    job = None
    if common.valid_job_id(job_id):
        job = common.read_job(settings, job_id)
    if job is None:
        return error('No job {}'.format(job_id), 404)
    return jsonify(job)


# ─── WebUI ──────────────────────────────────────────────────────────────────────

def page(template, **values):
    """Render a page of webui/templates/, with the values webui_base.html needs."""
    return render_template(
        template,
        pack='slurm',
        version=settings['version'],
        packs=settings['webui_packs'],
        pack_menu=[],
        user=g.user['name'],
        level=g.user['role'],
        **values,
    )


@app.route('/', methods=['GET'])
def index_page():
    return page('index.html')


@app.route('/hosts/<hostname>', methods=['GET'])
def host_page(hostname):
    if hostname not in common.read_state(settings)['nodes']:
        return error('{} is not a Slurm node'.format(hostname), 404)
    return page('host.html', host=hostname)


@app.route('/jobs/<job_id>', methods=['GET'])
def job_page(job_id):
    if not common.valid_job_id(job_id) or common.read_job(settings, job_id) is None:
        return error('No job {}'.format(job_id), 404)
    return page('job.html', job=job_id)


@app.route('/static/<path:filename>', methods=['GET'])
def static_file(filename):
    return send_from_directory(os.path.join(settings['webui_path'], 'static'), filename)


def main():
    global settings, hosts
    parser = argparse.ArgumentParser(description='bluebanquise-slurm REST API and WebUI daemon')
    parser.add_argument('--settings', default=common.SETTINGS_FILE, help='Settings file')
    parser.add_argument('--log-level', default=None, help='DEBUG, INFO, WARNING, ERROR')
    args = parser.parse_args()

    common.setup_logging(args.log_level or 'INFO')
    settings = common.load_settings(args.settings)
    common.setup_logging(args.log_level or settings['log_level'])
    common.drop_privileges(settings['api_user'])
    hosts = common.load_hosts(settings)
    app.template_folder = os.path.join(settings['webui_path'], 'templates')

    logging.info('bluebanquise-slurm-api starting')
    webui_auth.start('slurm')
    logging.info('Listening on %s:%d, under %s', settings['api_bind'], settings['api_port'], settings['url_prefix'])
    serve(app, host=settings['api_bind'], port=settings['api_port'], url_prefix=settings['url_prefix'])


if __name__ == '__main__':
    main()
