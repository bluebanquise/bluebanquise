#### Blue Banquise file ####
## {{ ansible_managed }}
# bluebanquise-operation WebUI and REST API, served by Apache under {{ bluebanquise_operation_url_prefix }}/
# The daemon listens on 127.0.0.1:{{ bluebanquise_operation_api_port }} and checks users itself.

RedirectMatch "^{{ bluebanquise_operation_url_prefix }}$" "{{ bluebanquise_operation_url_prefix }}/"
ProxyPass "{{ bluebanquise_operation_url_prefix }}/" "http://127.0.0.1:{{ bluebanquise_operation_api_port }}{{ bluebanquise_operation_url_prefix }}/"
ProxyPassReverse "{{ bluebanquise_operation_url_prefix }}/" "http://127.0.0.1:{{ bluebanquise_operation_api_port }}{{ bluebanquise_operation_url_prefix }}/"
