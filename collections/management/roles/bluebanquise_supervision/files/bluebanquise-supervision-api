#!/usr/lib/bluebanquise/venv/bin/python3
"""
bluebanquise-supervision-api: REST API and WebUI daemon of bluebanquise-supervision.

Served by waitress (production WSGI server). Every request needs HTTP basic authentication, and
the level given to each route in ROUTE_LEVELS (webui_auth.py, users of bluebanquise_webui_users).
Every write action writes an AUDIT line in the journal.

REST API (JSON):
  GET    /api/hosts                       state of all hosts, and counts per state
  GET    /api/hosts/<host>                state, maintenance and last probe results of a host
  GET    /api/hosts/<host>/events         events log of a host
  POST   /api/hosts/<host>/probe          probe a host now
  POST   /api/hosts/<host>/acknowledge    {"reason": "..."}
  POST   /api/hosts/<host>/maintenance    {"reason": "..."}  start maintenance
  DELETE /api/hosts/<host>/maintenance    {"reason": "..."}  stop maintenance
  POST   /api/hosts/<host>/notes          {"text": "..."}
POST and DELETE requests must be sent as JSON (Content-Type: application/json): a browser can
not send such a request from another web site, which protects the API against cross-site
requests made with the cached credentials of an admin (checked by webui_auth.py).

WebUI (Jinja pages, Bulma, plain JavaScript using the REST API):
  GET /              summary and cluster map
  GET /hosts/<host>  host page
  GET /static/...    CSS and JavaScript files

The daemon listens on 127.0.0.1 only. Apache serves it under /webui/supervision/ (url_prefix of
the settings): waitress removes this prefix, so the routes above stay as written, and
request.script_root holds the prefix for the pages.

The daemon never runs probes itself: a probe request is a file read by the probe daemon.
"""

import argparse
import logging
import os
import sys
import unicodedata
import uuid

from flask import Flask, g, jsonify, render_template, request, send_from_directory
from waitress import serve

sys.path.insert(0, '/usr/lib/bluebanquise/bluebanquise-supervision/lib')
import common  # noqa: E402
import webui_auth  # noqa: E402

app = Flask(__name__, static_folder=None)

# Loaded once at startup in main(), the role restarts the service when they change.
# Users are not loaded here: webui_auth.py reads them at every request.
settings = None
hosts = None

# Reasons and notes: at most this number of characters
MAX_TEXT = 1000

# Who can do what: minimum level (viewer, operator, admin) of each route below, by the name of
# its function. A route missing here is refused to everyone.
ROUTE_LEVELS = {
    # REST API
    'get_hosts': 'operator',
    'get_host': 'operator',
    'get_host_events': 'operator',
    'post_host_probe': 'operator',
    'post_host_acknowledge': 'operator',
    'host_maintenance': 'operator',
    'post_host_note': 'operator',
    # WebUI
    'index_page': 'operator',
    'host_page': 'operator',
    'static_file': 'viewer',
}


def error(message, code):
    logging.info('%s %s -> %d %s', request.method, request.path, code, message)
    return jsonify({'error': message}), code


def result(action, hostname, ok, message, reason):
    """Audit line, then answer, for actions of common.py, which return (ok, message)."""
    if ok:
        webui_auth.audit(action, hostname, 'ok', message + ' (' + reason + ')')
        return jsonify({'message': message})
    webui_auth.audit(action, hostname, 'failed', message + ' (' + reason + ')')
    return error(message, 409)


def json_field(name):
    """Mandatory text field of the JSON body, or None: a string of at most MAX_TEXT characters, on
    one line. Control characters (new line, tab, escape...) and line separators are refused: the
    text goes to events and logs, as one line."""
    data = request.get_json(silent=True)
    if not isinstance(data, dict) or not isinstance(data.get(name), str):
        return None
    value = data[name].strip()
    if value == '' or len(value) > MAX_TEXT:
        return None
    for character in value:
        if unicodedata.category(character) in ('Cc', 'Zl', 'Zp'):
            return None
    return value


@app.before_request
def check_user():
    """User, password and level of every request (webui_auth.py)."""
    return webui_auth.check_request(ROUTE_LEVELS)


# ─── REST API ───────────────────────────────────────────────────────────────────

@app.route('/api/hosts', methods=['GET'])
def get_hosts():
    summaries = []
    counts = {'ok': 0, 'error': 0, 'maintenance': 0, 'unknown': 0}
    for hostname in sorted(hosts):
        summary = common.host_summary(settings, hostname, hosts[hostname])
        counts[summary['state']] = counts[summary['state']] + 1
        summaries.append(summary)
    return jsonify({'hosts': summaries, 'counts': counts})


@app.route('/api/hosts/<hostname>', methods=['GET'])
def get_host(hostname):
    if hostname not in hosts:
        return error('{} is not a supervised host'.format(hostname), 404)
    return jsonify({
        'summary': common.host_summary(settings, hostname, hosts[hostname]),
        'maintenance': common.read_maintenance(settings, hostname),
        'probes': common.read_probes(settings, hostname),
    })


@app.route('/api/hosts/<hostname>/events', methods=['GET'])
def get_host_events(hostname):
    if hostname not in hosts:
        return error('{} is not a supervised host'.format(hostname), 404)
    return jsonify({'events': common.read_events(settings, hostname)})


@app.route('/api/hosts/<hostname>/probe', methods=['POST'])
def post_host_probe(hostname):
    if hostname not in hosts:
        return error('{} is not a supervised host'.format(hostname), 404)
    request_id = str(uuid.uuid4())
    with open(os.path.join(settings['requests_path'], hostname), 'w') as f:
        f.write(request_id)
    webui_auth.audit('probe', hostname, 'ok', 'Probe requested, request id ' + request_id)
    return jsonify({'message': 'Probe of {} requested'.format(hostname), 'request_id': request_id})


@app.route('/api/hosts/<hostname>/acknowledge', methods=['POST'])
def post_host_acknowledge(hostname):
    if hostname not in hosts:
        return error('{} is not a supervised host'.format(hostname), 404)
    reason = json_field('reason')
    if reason is None:
        return error('A reason is needed (one line of text, at most {} characters)'.format(MAX_TEXT), 400)
    ok, message = common.acknowledge(settings, hostname, g.user['name'], reason)
    return result('acknowledge', hostname, ok, message, reason)


@app.route('/api/hosts/<hostname>/maintenance', methods=['POST', 'DELETE'])
def host_maintenance(hostname):
    if hostname not in hosts:
        return error('{} is not a supervised host'.format(hostname), 404)
    reason = json_field('reason')
    if reason is None:
        return error('A reason is needed (one line of text, at most {} characters)'.format(MAX_TEXT), 400)
    if request.method == 'POST':
        ok, message = common.start_maintenance(settings, hostname, g.user['name'], reason)
        return result('maintenance.start', hostname, ok, message, reason)
    else:
        ok, message = common.stop_maintenance(settings, hostname, g.user['name'], reason)
        return result('maintenance.stop', hostname, ok, message, reason)


@app.route('/api/hosts/<hostname>/notes', methods=['POST'])
def post_host_note(hostname):
    if hostname not in hosts:
        return error('{} is not a supervised host'.format(hostname), 404)
    text = json_field('text')
    if text is None:
        return error('A text is needed (one line of text, at most {} characters)'.format(MAX_TEXT), 400)
    ok, message = common.add_note(settings, hostname, g.user['name'], text)
    return result('note', hostname, ok, message, text)


# ─── WebUI ──────────────────────────────────────────────────────────────────────

def page(template, **values):
    """Render a page of webui/templates/, with the values webui_base.html needs."""
    return render_template(
        template,
        pack='supervision',
        version=settings['version'],
        packs=settings['webui_packs'],
        pack_menu=[],
        user=g.user['name'],
        level=g.user['role'],
        **values,
    )


@app.route('/', methods=['GET'])
def index_page():
    return page('index.html')


@app.route('/hosts/<hostname>', methods=['GET'])
def host_page(hostname):
    if hostname not in hosts:
        return error('{} is not a supervised host'.format(hostname), 404)
    return page('host.html', host=hostname)


@app.route('/static/<path:filename>', methods=['GET'])
def static_file(filename):
    return send_from_directory(os.path.join(settings['webui_path'], 'static'), filename)


def main():
    global settings, hosts
    parser = argparse.ArgumentParser(description='bluebanquise-supervision REST API and WebUI daemon')
    parser.add_argument('--settings', default=common.SETTINGS_FILE, help='Settings file')
    parser.add_argument('--log-level', default=None, help='DEBUG, INFO, WARNING, ERROR')
    args = parser.parse_args()

    common.setup_logging(args.log_level or 'INFO')
    settings = common.load_settings(args.settings)
    common.setup_logging(args.log_level or settings['log_level'])
    common.drop_privileges(settings['user'])
    hosts = common.load_hosts(settings)
    app.template_folder = os.path.join(settings['webui_path'], 'templates')

    logging.info('bluebanquise-supervision-api starting: %d host(s)', len(hosts))
    webui_auth.start('supervision')
    logging.info('Listening on %s:%d, under %s', settings['api_bind'], settings['api_port'], settings['url_prefix'])
    # waitress writes no access log, every write route logs its own requests
    serve(app, host=settings['api_bind'], port=settings['api_port'], url_prefix=settings['url_prefix'])


if __name__ == '__main__':
    main()
