#jinja2: lstrip_blocks: True
[Unit]
  Description=Prometheus Monitoring
  Wants=network-online.target
  After=network-online.target

[Service]
  User=prometheus
  Group=prometheus
  Type=simple
  ExecStart=/usr/bin/prometheus \
{% if prometheus_server_enable_tls | bool or prometheus_server_enable_basic_auth | bool %}
  --web.config.file=/etc/prometheus/web.yml \
{% endif %}
  {{ prometheus_server_prometheus_launch_parameters | indent(2, True) }}

[Install]
  WantedBy=multi-user.target
