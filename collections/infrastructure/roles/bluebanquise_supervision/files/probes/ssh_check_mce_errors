#!/bin/bash
# Check for Machine Check Exceptions (MCE) hardware errors in dmesg.
# Usage: ssh_check_mce_errors

echo "Checking for MCE hardware errors..."

# The kernel log needs root on most distributions (kernel.dmesg_restrict), so sudo is used. Not
# being able to read it is an error, never taken as "no error found".
if ! KERNEL_LOG=$(sudo -n dmesg -T 2>&1); then
    echo "CRITICAL: cannot read kernel log (sudo dmesg failed): $KERNEL_LOG"
    exit 2
fi

# Only real error reports: "mce: CPU supports 22 MCE banks" and similar lines are printed at every
# boot on real servers. Errors are tagged "[Hardware Error]" by the kernel, and summarized as
# "Machine check events logged".
MCE_LOG=$(echo "$KERNEL_LOG" | grep -Ei "\[Hardware Error\]|Machine check events logged")

if [[ -n "$MCE_LOG" ]]; then
    echo "CRITICAL: MCE hardware errors detected"
    echo "$MCE_LOG"
    exit 2
fi

echo "OK: No MCE errors detected"
exit 0
