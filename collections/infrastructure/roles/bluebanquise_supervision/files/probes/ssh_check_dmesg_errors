#!/bin/bash
# Check for kernel log errors using dmesg.
# Usage: ssh_check_dmesg_errors "err"
# You can pass any valid dmesg level: emerg, alert, crit, err, warn, etc.
# You can also pass on modern systems: err+ for example, this means err and all above levels
# Default level is "err" if not provided.

LEVEL="${1:-err}"

echo "Checking dmesg for messages with level: $LEVEL"

# The kernel log needs root on most distributions (kernel.dmesg_restrict), so sudo is used. Not
# being able to read it is an error, never taken as "no error found".
if ! KERNEL_LOG=$(sudo -n dmesg -T --level="$LEVEL" 2>&1); then
    echo "CRITICAL: cannot read kernel log (sudo dmesg failed): $KERNEL_LOG"
    exit 2
fi

DMESG_OUTPUT="$KERNEL_LOG"

if [[ -z "$DMESG_OUTPUT" ]]; then
    echo "OK: No dmesg entries found at level '$LEVEL'"
    exit 0
fi

echo "CRITICAL: dmesg contains entries at level '$LEVEL'"
echo "---- dmesg output start ----"
echo "$DMESG_OUTPUT"
echo "---- dmesg output end ----"
exit 2
