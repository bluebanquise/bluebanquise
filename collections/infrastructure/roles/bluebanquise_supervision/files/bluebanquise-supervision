#!/usr/lib/bluebanquise/venv/bin/python3
"""
bluebanquise-supervision: command line tool of bluebanquise-supervision.

  bluebanquise-supervision status                        state of all supervised hosts
  bluebanquise-supervision show <host>                   last probe results of a host
  bluebanquise-supervision events <host>                 events log of a host
  bluebanquise-supervision probe <host> [--no-wait]      probe a host now
  bluebanquise-supervision ack <host> <reason>           acknowledge a host error
  bluebanquise-supervision maintenance start <host> <reason>
  bluebanquise-supervision maintenance stop <host> <reason>
  bluebanquise-supervision note <host> <text>            add a note to the events log
  bluebanquise-supervision hash-password                 hash a WebUI password for the inventory

Run as root (or with sudo): the tool reads the name of the admin from SUDO_USER/USER (written in
events), then switches to the bluebanquise-supervision user before touching any file. It works
on the files directly: only "probe" needs the probe daemon to be running.
"""

import argparse
import getpass
import os
import pwd
import sys
import time
import uuid

sys.path.insert(0, '/usr/lib/bluebanquise/bluebanquise-supervision/lib')
import common  # noqa: E402

COLORS = {
    'ok': '\033[92m',
    'error': '\033[91m',
    'maintenance': '\033[94m',
    'unknown': '\033[90m',
}
COLOR_END = '\033[0m'


def colored(text, state):
    """Color text by state, only when printing to a terminal."""
    if not sys.stdout.isatty():
        return text
    return COLORS.get(state, '') + text + COLOR_END


def admin_name():
    """Name of the person running the tool, as written in events."""
    if os.environ.get('SUDO_USER'):
        return os.environ['SUDO_USER']
    return pwd.getpwuid(os.getuid()).pw_name


def check_host(hosts, hostname):
    if hostname not in hosts:
        print('Error: {} is not a supervised host (see bluebanquise_supervision_checks)'.format(hostname))
        sys.exit(1)


def print_result(ok, message):
    print(message)
    if not ok:
        sys.exit(1)


# ─── commands ───────────────────────────────────────────────────────────────────

def command_status(settings, hosts, args):
    line_format = '{:<20} {:<20} {:<13} {:<8} {:<26} {}'
    print(line_format.format('HOST', 'GROUP', 'STATE', 'LATCHED', 'LAST PROBE', 'FAILED'))
    counts = {'ok': 0, 'error': 0, 'maintenance': 0, 'unknown': 0}
    for hostname in sorted(hosts):
        summary = common.host_summary(settings, hostname, hosts[hostname])
        counts[summary['state']] = counts[summary['state']] + 1
        state = '{:<13}'.format(summary['state'])
        print(line_format.format(hostname, summary['group'], colored(state, summary['state']),
                                 'yes' if summary['latched'] else 'no',
                                 summary['last_probe'] or 'never', ', '.join(summary['failed'])))
    print()
    print('{} hosts: {} ok, {} error, {} maintenance, {} never probed'.format(
        len(hosts), counts['ok'], counts['error'], counts['maintenance'], counts['unknown']))


def print_output(text):
    for line in text.rstrip().splitlines():
        print('      ' + line)


def command_show(settings, hosts, args):
    hostname = args.host
    check_host(hosts, hostname)
    summary = common.host_summary(settings, hostname, hosts[hostname])
    maintenance = common.read_maintenance(settings, hostname)
    data = common.read_probes(settings, hostname)

    print('{}: {}'.format(hostname, colored(summary['state'], summary['state'])))
    if maintenance['active']:
        print('In maintenance since {} by {}: {}'.format(maintenance['since'], maintenance['by'], maintenance['reason']))
    if summary['latched']:
        print('Error not acknowledged yet, see: bluebanquise-supervision events {}'.format(hostname))
    if data is None:
        print('Never probed')
        return

    print('Last probe: {} -> {}{}'.format(data['started'], data['finished'],
                                          ' (on demand)' if data['request_id'] else ''))
    if data['ssh'] is True:
        print('SSH: ok')
    elif data['ssh'] is False:
        print(colored('SSH: failed', 'error'))

    for probe_name in data['probes']:
        result = data['probes'][probe_name]
        state = 'error' if result['error'] else 'ok'
        print()
        print('  {} {} - exit code {}, {}s'.format(
            colored('[{}]'.format(state.upper()), state), probe_name, result['exit_code'], result['duration']))
        if result['args'] is not None:
            print('      args: {}'.format(result['args']))
        print_output(result['stdout'])
        print_output(result['stderr'])

    if 'drift' in data:
        result = data['drift']
        state = 'error' if result['error'] else 'ok'
        print()
        print('  {} drift check - {}s'.format(colored('[{}]'.format(state.upper()), state), result['duration']))
        for finding in result['findings']:
            print('      ' + finding)
        print_output(result['stderr'])


def command_events(settings, hosts, args):
    check_host(hosts, args.host)
    events = common.read_events(settings, args.host)
    if len(events) == 0:
        print('No events for {}'.format(args.host))
        return
    for event in events:
        by = ''
        if 'by' in event:
            by = ' by ' + event['by']
        kind = event['kind']
        if kind == 'Error':
            kind = colored(kind, 'error')
        elif kind.startswith('Maintenance'):
            kind = colored(kind, 'maintenance')
        print('[{}] {} {}{}: {}'.format(event['number'], event['time'], kind, by, event['message']))


def command_probe(settings, hosts, args):
    hostname = args.host
    check_host(hosts, hostname)
    request_id = str(uuid.uuid4())
    request_path = os.path.join(settings['requests_path'], hostname)
    with open(request_path, 'w') as f:
        f.write(request_id)
    print('Probe of {} requested'.format(hostname))
    if args.no_wait:
        return

    # The probe daemon writes the request id in probes.yml when this probe is done
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        data = common.read_probes(settings, hostname)
        if data is not None and data['request_id'] == request_id:
            print()
            command_show(settings, hosts, args)
            return
        time.sleep(0.5)
    if os.path.exists(request_path):
        print('Error: request not picked up after {}s, is bluebanquise-supervision-probe running?'.format(args.timeout))
    else:
        print('Error: probe still running after {}s, check later with: bluebanquise-supervision show {}'.format(
            args.timeout, hostname))
    sys.exit(1)


def command_ack(settings, hosts, args):
    check_host(hosts, args.host)
    ok, message = common.acknowledge(settings, args.host, args.by, ' '.join(args.reason))
    print_result(ok, message)


def command_maintenance(settings, hosts, args):
    check_host(hosts, args.host)
    if args.action == 'start':
        ok, message = common.start_maintenance(settings, args.host, args.by, ' '.join(args.reason))
    else:
        ok, message = common.stop_maintenance(settings, args.host, args.by, ' '.join(args.reason))
    print_result(ok, message)


def command_note(settings, hosts, args):
    check_host(hosts, args.host)
    ok, message = common.add_note(settings, args.host, args.by, ' '.join(args.text))
    print_result(ok, message)


def command_hash_password():
    # Imported here: only this command needs werkzeug
    from werkzeug.security import generate_password_hash
    password = getpass.getpass('Password: ')
    if password != getpass.getpass('Password again: '):
        print('Error: passwords do not match')
        sys.exit(1)
    print(generate_password_hash(password))


# ─── main ───────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description='bluebanquise-supervision command line tool')
    parser.add_argument('--settings', default=common.SETTINGS_FILE, help=argparse.SUPPRESS)
    subparsers = parser.add_subparsers(dest='command', required=True)

    subparsers.add_parser('status', help='State of all supervised hosts')

    sub = subparsers.add_parser('show', help='Last probe results of a host')
    sub.add_argument('host')

    sub = subparsers.add_parser('events', help='Events log of a host')
    sub.add_argument('host')

    sub = subparsers.add_parser('probe', help='Probe a host now (needs the probe daemon)')
    sub.add_argument('host')
    sub.add_argument('--no-wait', action='store_true', help='Do not wait for the result')
    sub.add_argument('--timeout', type=int, default=300, help='Seconds to wait for the result (default 300)')

    sub = subparsers.add_parser('ack', help='Acknowledge a host error')
    sub.add_argument('host')
    sub.add_argument('reason', nargs='+')

    sub = subparsers.add_parser('maintenance', help='Start or stop maintenance of a host')
    sub.add_argument('action', choices=['start', 'stop'])
    sub.add_argument('host')
    sub.add_argument('reason', nargs='+')

    sub = subparsers.add_parser('note', help='Add a note to the events log of a host')
    sub.add_argument('host')
    sub.add_argument('text', nargs='+')

    subparsers.add_parser('hash-password', help='Hash a password for bluebanquise_supervision_webui_users')

    args = parser.parse_args()

    if args.command == 'hash-password':
        command_hash_password()
        return

    # Admin name first, then switch to the daemons user so every file keeps the right owner
    args.by = admin_name()
    common.setup_logging('WARNING')
    try:
        settings = common.load_settings(args.settings)
    except PermissionError:
        print('Error: permission denied on {}, run as root (or with sudo)'.format(args.settings))
        sys.exit(1)
    common.drop_privileges(settings['user'])
    hosts = common.load_hosts(settings)

    if args.command == 'status':
        command_status(settings, hosts, args)
    elif args.command == 'show':
        command_show(settings, hosts, args)
    elif args.command == 'events':
        command_events(settings, hosts, args)
    elif args.command == 'probe':
        command_probe(settings, hosts, args)
    elif args.command == 'ack':
        command_ack(settings, hosts, args)
    elif args.command == 'maintenance':
        command_maintenance(settings, hosts, args)
    elif args.command == 'note':
        command_note(settings, hosts, args)


if __name__ == '__main__':
    main()
