#jinja2: lstrip_blocks: True
#### Blue Banquise file ####
## {{ ansible_managed }}

{# Sort served networks: networks with a shared_network value are grouped by this value #}
{% set ns = namespace(shared={}, standalone=[]) %}
{% for network_name in dhcp_server_networks %}
  {% set shared_name = networks[network_name]['shared_network'] | default('', true) %}
  {% if shared_name %}
    {% set ns.shared = ns.shared | combine({shared_name: (ns.shared[shared_name] | default([])) + [network_name]}) %}
  {% else %}
    {% set ns.standalone = ns.standalone + [network_name] %}
  {% endif %}
{% endfor %}

# Shared networks
"shared-networks": [
{% for shared_name in ns.shared %}
  {
    "name": "{{ shared_name }}",
    "subnet4": [
  {% for network_name in ns.shared[shared_name] %}
      <?include "{{ dhcp_server_conf_dir }}/kea-dhcp4.{{ network_name }}.conf"?>{% if not loop.last %},{% endif %}

  {% endfor %}
    ]
  }{% if not loop.last %},{% endif %}

{% endfor %}
],

# Not shared networks
"subnet4": [
{% for network_name in ns.standalone %}
  <?include "{{ dhcp_server_conf_dir }}/kea-dhcp4.{{ network_name }}.conf"?>{% if not loop.last %},{% endif %}

{% endfor %}
]
