#jinja2: lstrip_blocks: True
#### Blue Banquise file ####
## {{ ansible_managed }}

{# iPXE rom file name parts: <embed>_<driver>_ipxe.efi, default driver has no name part #}
{% if dhcp_server_ipxe_driver in ['snp', 'snponly'] %}
  {% set ipxe_driver = dhcp_server_ipxe_driver ~ '_' %}
{% else %}
  {% set ipxe_driver = '' %}
{% endif %}
{% if dhcp_server_ipxe_embed in ['dhcpretry', 'noshell', 'allretry'] %}
  {% set ipxe_embed = dhcp_server_ipxe_embed %}
{% else %}
  {% set ipxe_embed = 'standard' %}
{% endif %}

{#
  Networks served by this DHCP server, with their PXE server ip (pxe4 or pxe service, else
  services_ip), used to build per-network HTTP boot classes. Same logic as in kea-dhcp4.subnet.conf.j2.
#}
{% set ns = namespace(http_boot_networks=[]) %}
{% for network_name in dhcp_server_networks %}
  {% set network = networks[network_name] %}
  {% set services = network['services'] | default({}, true) %}
  {% set pxe_entries = services['pxe4'] | default(services['pxe'], true) | default([], true) %}
  {% set pxe_ip = '' %}
  {% if pxe_entries | length > 0 and pxe_entries[0]['ip4'] is defined and pxe_entries[0]['ip4'] %}
    {% set pxe_ip = pxe_entries[0]['ip4'] | split('/') | first %}
  {% elif network['services_ip'] is defined and network['services_ip'] %}
    {% set pxe_ip = network['services_ip'] %}
  {% endif %}
  {% if pxe_ip %}
    {% set ns.http_boot_networks = ns.http_boot_networks + [{'network': network_name, 'pxe_ip': pxe_ip}] %}
  {% endif %}
{% endfor %}

{
  "Dhcp4": {
    "interfaces-config": {
      "interfaces": {{ dhcp_server_listen_interfaces | to_json }}
    },

    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/{{ dhcp_server_lease_file }}"
    },

    "valid-lifetime": {{ dhcp_server_default_lease_time }},
    "max-valid-lifetime": {{ dhcp_server_max_lease_time }},

    # Identify clients by their MAC address only (see README, "Client identifier matching")
    "match-client-id": {{ dhcp_server_match_client_id | bool | lower }},

    # Organize hosts booting by classes, using client architecture (option 93) and vendor class (option 60).
    # PXE clients receive a TFTP file name. UEFI HTTP boot clients (x86_64: 0x0010, arm64: 0x0013)
    # receive a HTTP URL, from per-network classes, as the URL uses the PXE server ip of the client network.
    # Per-network classes are only evaluated for the network requiring them (only-if-required).
    "client-classes": [
      {
        "name": "arch_x86_legacy",
        "test": "option[93].hex == 0x0000",
        "option-data": [ { "name": "boot-file-name", "data": "x86_64/{{ ipxe_embed }}_undionly.kpxe" } ]
      },
      {
        "name": "arch_x86_64_efi",
        "test": "(option[93].hex == 0x0007 or option[93].hex == 0x0009) and not (substring(option[60].hex, 0, 10) == 'HTTPClient')",
        "option-data": [ { "name": "boot-file-name", "data": "x86_64/{{ ipxe_embed }}_{{ ipxe_driver }}ipxe.efi" } ]
      },
      {
        "name": "arch_arm64_efi",
        "test": "option[93].hex == 0x000b and not (substring(option[60].hex, 0, 10) == 'HTTPClient')",
        "option-data": [ { "name": "boot-file-name", "data": "arm64/{{ ipxe_embed }}_{{ ipxe_driver }}ipxe.efi" } ]
      },
      {
        "name": "arch_x86_64_http_boot",
        "test": "substring(option[60].hex, 0, 10) == 'HTTPClient' and option[93].hex == 0x0010"
      },
      {
        "name": "arch_arm64_http_boot",
        "test": "substring(option[60].hex, 0, 10) == 'HTTPClient' and option[93].hex == 0x0013"
      }
{% for entry in ns.http_boot_networks %}
      ,{
        "name": "arch_x86_64_http_boot_{{ entry.network }}",
        "test": "member('arch_x86_64_http_boot')",
        "only-if-required": true,
        "option-data": [ { "name": "boot-file-name", "data": "http://{{ entry.pxe_ip }}/pxe/x86_64/{{ ipxe_embed }}_{{ ipxe_driver }}ipxe.efi" } ]
      },
      {
        "name": "arch_arm64_http_boot_{{ entry.network }}",
        "test": "member('arch_arm64_http_boot')",
        "only-if-required": true,
        "option-data": [ { "name": "boot-file-name", "data": "http://{{ entry.pxe_ip }}/pxe/arm64/{{ ipxe_embed }}_{{ ipxe_driver }}ipxe.efi" } ]
      }
{% endfor %}
    ],

    # Logging
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output_options": [ { "output": "stdout" } ],
        "severity": "{{ dhcp_server_log_severity }}"{% if dhcp_server_log_severity == 'DEBUG' %},
        "debuglevel": 7{% endif %}

      }
    ],

    # Include subnets dispatching
    <?include "{{ dhcp_server_conf_dir }}/kea-dhcp4.networks.conf"?>

  }
}
