{{ ansible_managed | comment }}
[Unit]
Description=BlueBanquise Cluster Playbooks Daemon
After=network.target

[Service]
Type=simple
User=bluebanquise
Group=bluebanquise
ExecStart={{ cluster_playbooks_daemon_script_path }} {{ cluster_playbooks_daemon_conf_path }}
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
