#!/usr/bin/env python3
"""
BlueBanquise cluster playbooks daemon.

Watches the inventory folder and, per fn_* function group, pushes the playbook generated from
current_config.yml to any member host whose /etc/bluebanquise/tags/inventory checksum doesn't
match the current inventory state.
"""

import argparse
import concurrent.futures
import hashlib
import logging
import os
import re
import subprocess
import sys
import time
import yaml
from datetime import datetime, timezone

LOG_FORMAT = '%(asctime)s [%(levelname)s] %(message)s'

ANSI_ESCAPE_RE = re.compile(r'\x1b\[[0-9;]*m')
RECAP_LINE_RE = re.compile(
    r'^(?P<host>\S+)\s*:\s*ok=(?P<ok>\d+)\s+changed=(?P<changed>\d+)\s+'
    r'unreachable=(?P<unreachable>\d+)\s+failed=(?P<failed>\d+)'
)


def setup_logging(log_level):
    level = getattr(logging, log_level.upper(), logging.INFO)
    root = logging.getLogger()
    root.setLevel(level)
    if not root.handlers:
        handler = logging.StreamHandler(sys.stdout)
        handler.setFormatter(logging.Formatter(LOG_FORMAT))
        root.addHandler(handler)
    else:
        for handler in root.handlers:
            handler.setLevel(level)


def load_daemon_config(path):
    """Load this daemon's own settings file (generated by the cluster_playbooks role)."""
    logging.info('Loading daemon configuration from %s', path)
    with open(path, 'r') as f:
        config = yaml.safe_load(f)
    logging.debug('Daemon configuration: %s', config)
    return config


def load_conf(conf_path):
    """Load the Ansible-generated catalog: function_profiles and function_groups."""
    logging.info('Loading function profile catalog: %s', conf_path)
    try:
        with open(conf_path, 'r') as f:
            conf = yaml.safe_load(f) or {}
    except OSError as e:
        logging.error('Could not read %s: %s (has the cluster_playbooks role been run on this host?)',
                      conf_path, e)
        return {'function_profiles': {}, 'function_groups': {}}
    except yaml.YAMLError as e:
        logging.error('Could not parse %s: %s', conf_path, e)
        return {'function_profiles': {}, 'function_groups': {}}
    conf.setdefault('function_profiles', {})
    conf.setdefault('function_groups', {})
    logging.info('Loaded %d function profile(s), %d function group(s) from catalog',
                 len(conf['function_profiles']), len(conf['function_groups']))
    logging.debug('Known function groups: %s', sorted(conf['function_groups']))
    logging.debug('Known function profiles: %s', sorted(conf['function_profiles']))
    return conf


def load_current_config(current_config_path):
    """Load the operator-managed selection state written by the bluebanquise-playbook CLI."""
    logging.info('Loading operator selection: %s', current_config_path)
    if not os.path.exists(current_config_path):
        logging.info('No current_config.yml yet at %s - nothing has been configured via '
                     'bluebanquise-playbook, daemon will idle', current_config_path)
        return {'function_groups': {}}
    try:
        with open(current_config_path, 'r') as f:
            data = yaml.safe_load(f) or {}
    except OSError as e:
        logging.error('Could not read %s: %s', current_config_path, e)
        return {'function_groups': {}}
    except yaml.YAMLError as e:
        logging.error('Could not parse %s: %s', current_config_path, e)
        return {'function_groups': {}}
    data.setdefault('function_groups', {})
    logging.info('Loaded selection for %d function group(s): %s',
                 len(data['function_groups']), sorted(data['function_groups']))
    return data


# ─── inventory checksum ────────────────────────────────────────────────────────

def compute_inventory_checksum(inventory_path):
    """sha256 over sorted (relative path, content sha256) pairs. Content-only: ignores mtime
    and permissions, so touching a file without changing it never triggers a fleet-wide push.
    Skips dotfiles/dirs and __pycache__.
    """
    logging.debug('Computing checksum for inventory folder: %s', inventory_path)
    file_entries = []

    for root, dirs, files in os.walk(inventory_path):
        dirs[:] = sorted(d for d in dirs if not d.startswith('.') and d != '__pycache__')
        for filename in sorted(files):
            if filename.startswith('.'):
                continue
            file_path = os.path.join(root, filename)
            rel_path = os.path.relpath(file_path, inventory_path)
            try:
                with open(file_path, 'rb') as f:
                    content_hash = hashlib.sha256(f.read()).hexdigest()
            except OSError as e:
                logging.warning('Could not read %s while computing checksum, skipping it: %s',
                                file_path, e)
                continue
            logging.debug('  %s -> %s', rel_path, content_hash)
            file_entries.append((rel_path, content_hash))

    file_entries.sort(key=lambda entry: entry[0])

    hasher = hashlib.sha256()
    for rel_path, content_hash in file_entries:
        hasher.update(rel_path.encode('utf-8'))
        hasher.update(content_hash.encode('utf-8'))
    checksum = hasher.hexdigest()

    logging.debug('Inventory checksum computed from %d file(s): %s', len(file_entries), checksum)
    return checksum


# ─── SSH helpers (same approach as bluebanquise-cluster-dynamic) ──────────────

def run_ssh_command(hostname, command, timeout):
    """Run a single command on a remote host via SSH. Returns (stdout, returncode)."""
    cmd = [
        'ssh',
        '-o', 'ConnectTimeout={}'.format(timeout),
        '-o', 'BatchMode=yes',
        '-o', 'StrictHostKeyChecking=no',
        '-o', 'LogLevel=ERROR',
        hostname,
        command,
    ]
    logging.debug('[%s] SSH command: %s', hostname, ' '.join(cmd))
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 5)
        if result.stdout:
            logging.debug('[%s] SSH stdout: %s', hostname, result.stdout.strip())
        if result.stderr:
            logging.debug('[%s] SSH stderr: %s', hostname, result.stderr.strip())
        return result.stdout, result.returncode
    except subprocess.TimeoutExpired:
        logging.warning('[%s] SSH command timed out (command: %s)', hostname, command)
        return '', -1
    except Exception as e:
        logging.error('[%s] SSH command error: %s', hostname, e)
        return '', -1


def check_host_tag(hostname, host_tag_path, ssh_timeout):
    """Read the host's currently-tagged inventory checksum over SSH.

    Returns the checksum string, or None if the host is unreachable, SSH fails, or it has no
    tag file yet (all treated identically: the host is stale and needs a push).
    """
    command = 'cat {}/inventory 2>/dev/null'.format(host_tag_path)
    stdout, rc = run_ssh_command(hostname, command, ssh_timeout)
    if rc != 0:
        logging.info('[%s] Could not read inventory tag over SSH (rc=%d) - treating as stale',
                     hostname, rc)
        return None
    checksum = stdout.strip()
    if not checksum:
        logging.info('[%s] No inventory tag written yet - treating as stale', hostname)
        return None
    logging.debug('[%s] Current inventory tag: %s', hostname, checksum)
    return checksum


def check_hosts_threaded(hosts, config):
    """Thread-pooled SSH tag check across every host that belongs to a configured group."""
    host_tag_path = config['host_tag_path']
    ssh_timeout = config['ssh_timeout']
    thread_pool_size = config['thread_pool_size']

    logging.info('Checking inventory tag on %d host(s) via SSH (thread pool size %d)',
                 len(hosts), thread_pool_size)

    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=thread_pool_size) as executor:
        futures = {
            executor.submit(check_host_tag, hostname, host_tag_path, ssh_timeout): hostname
            for hostname in hosts
        }
        for future in concurrent.futures.as_completed(futures):
            hostname = futures[future]
            try:
                results[hostname] = future.result()
            except Exception as e:
                logging.error('[%s] Unhandled exception while checking host tag: %s', hostname, e)
                results[hostname] = None

    reachable = sum(1 for v in results.values() if v is not None)
    logging.info('Host tag check complete: %d/%d host(s) responded with a tag', reachable, len(hosts))
    return results


# ─── playbook generation ───────────────────────────────────────────────────────

def resolve_group_roles(conf, entry, fn_group):
    """Expand a current_config.yml group entry into an ordered role list.

    Order: entry['profiles'] in list order (each profile's own roles in catalog-declared
    order), then entry['roles'] in dict order (alphabetical, since bluebanquise-playbook always
    saves current_config.yml with sort_keys=True). Returns (role_list, error_message):
    error_message is set the moment a referenced profile isn't found in the catalog, in which
    case role_list is incomplete and must not be used.
    """
    function_profiles = conf.get('function_profiles', {})
    profiles = entry.get('profiles', []) or []
    roles = entry.get('roles', {}) or {}

    logging.debug('[%s] Resolving roles: %d profile(s) %s, %d ad hoc role(s) %s',
                  fn_group, len(profiles), profiles, len(roles), sorted(roles))

    role_list = []

    for profile_name in profiles:
        logging.debug('[%s] Expanding profile %r', fn_group, profile_name)
        if profile_name not in function_profiles:
            message = ("profile '{}' referenced in current_config.yml is not present in the "
                       'function profile catalog (was it removed or renamed?)').format(profile_name)
            logging.error('[%s] %s', fn_group, message)
            return [], message
        profile_roles = function_profiles[profile_name] or {}
        for role_fqcn, role_def in profile_roles.items():
            role_vars = (role_def or {}).get('vars', {}) or {}
            logging.debug('[%s]   + %s (from profile %r) vars=%s', fn_group, role_fqcn,
                          profile_name, role_vars)
            role_list.append({'role': role_fqcn, 'vars': role_vars})

    for role_fqcn, role_def in roles.items():
        role_vars = (role_def or {}).get('vars', {}) or {}
        logging.debug('[%s]   + %s (ad hoc role) vars=%s', fn_group, role_fqcn, role_vars)
        role_list.append({'role': role_fqcn, 'vars': role_vars})

    logging.info('[%s] Resolved %d role(s), appending cluster_host_tag', fn_group, len(role_list))
    return role_list, None


def generate_group_playbook(fn_group, role_list, config):
    """Write the generated playbook for one function group, atomically."""
    playbook_path = os.path.join(config['playbooks_path'], '{}.yml'.format(fn_group))
    tmp_path = os.path.join(config['tmp_path'], 'playbook_{}.yml.tmp'.format(fn_group))

    full_role_list = list(role_list) + [{'role': 'bluebanquise.infrastructure.cluster_host_tag'}]

    play = [{
        'name': 'cluster playbooks - {}'.format(fn_group),
        'hosts': fn_group,
        'roles': full_role_list,
    }]

    logging.info('[%s] Generating playbook %s (%d role(s) including cluster_host_tag)',
                 fn_group, playbook_path, len(full_role_list))
    logging.debug('[%s] Playbook content: %s', fn_group, play)

    try:
        os.makedirs(os.path.dirname(tmp_path), exist_ok=True)
        with open(tmp_path, 'w') as f:
            f.write('# Ansible managed file, do not edit\n')
            yaml.safe_dump(play, f, sort_keys=False, default_flow_style=False)
        os.replace(tmp_path, playbook_path)
    except OSError as e:
        logging.error('[%s] Failed to write generated playbook %s: %s', fn_group, playbook_path, e)
        raise

    logging.info('[%s] Playbook written: %s', fn_group, playbook_path)
    return playbook_path


# ─── playbook execution ────────────────────────────────────────────────────────

def build_ansible_playbook_command(playbook_path, stale_hosts, inventory_checksum, config):
    limit = ','.join(sorted(stale_hosts))
    return [
        config['ansible_playbook_bin'],
        playbook_path,
        '-i', config['inventory_path'],
        '--become',
        '--limit', limit,
        '-e', 'cluster_host_tag_inventory_checksum={}'.format(inventory_checksum),
        '-e', 'cluster_host_tag_path={}'.format(config['host_tag_path']),
    ]


def run_group_playbook(fn_group, playbook_path, stale_hosts, inventory_checksum, config):
    """Execute the generated playbook for one group, with forced color output captured whole."""
    cmd = build_ansible_playbook_command(playbook_path, stale_hosts, inventory_checksum, config)
    command_str = ' '.join(cmd)

    logging.info('[%s] Executing: %s', fn_group, command_str)

    env = os.environ.copy()
    env['ANSIBLE_FORCE_COLOR'] = '1'
    env['PY_COLORS'] = '1'
    env['ANSIBLE_CONFIG'] = config['ansible_config_path']
    logging.debug('[%s] Subprocess env overrides: ANSIBLE_FORCE_COLOR=1 PY_COLORS=1 ANSIBLE_CONFIG=%s',
                  fn_group, config['ansible_config_path'])

    start_time = datetime.now(timezone.utc)
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, env=env)
        output = (result.stdout or '') + (result.stderr or '')
        return_code = result.returncode
        logging.info('[%s] ansible-playbook exited with return code %d', fn_group, return_code)
    except Exception as e:
        logging.error('[%s] Failed to execute ansible-playbook: %s', fn_group, e)
        output = 'Failed to execute ansible-playbook: {}\n'.format(e)
        return_code = -1
    end_time = datetime.now(timezone.utc)

    logging.debug('[%s] Captured %d byte(s) of combined stdout/stderr in %.1fs',
                  fn_group, len(output), (end_time - start_time).total_seconds())

    per_host_success = parse_play_recap(output, stale_hosts)
    for hostname, success in sorted(per_host_success.items()):
        logging.info('[%s] Host %s: %s', fn_group, hostname, 'SUCCESS' if success else 'FAILED')

    return {
        'output': output,
        'return_code': return_code,
        'command': command_str,
        'end_time': end_time,
        'per_host_success': per_host_success,
    }


def parse_play_recap(output, expected_hosts):
    """Parse the PLAY RECAP block to determine per-host success.

    A host succeeds if it appears in the recap with unreachable=0 and failed=0. A host missing
    from the recap entirely (e.g. ansible-playbook crashed before reaching it) defaults to
    failed - fail safe rather than silently reporting success.
    """
    results = {hostname: False for hostname in expected_hosts}
    seen = set()

    logging.debug('Parsing PLAY RECAP for %d expected host(s): %s',
                  len(expected_hosts), sorted(expected_hosts))

    for raw_line in output.splitlines():
        clean_line = ANSI_ESCAPE_RE.sub('', raw_line).strip()
        match = RECAP_LINE_RE.match(clean_line)
        if not match:
            continue
        hostname = match.group('host')
        if hostname not in results:
            logging.debug('Recap line for unexpected host %r, ignoring', hostname)
            continue
        seen.add(hostname)
        unreachable = int(match.group('unreachable'))
        failed = int(match.group('failed'))
        success = unreachable == 0 and failed == 0
        logging.debug('[%s] Recap: ok=%s changed=%s unreachable=%s failed=%s -> %s',
                      hostname, match.group('ok'), match.group('changed'), unreachable, failed,
                      'success' if success else 'failed')
        results[hostname] = success

    missing = sorted(set(expected_hosts) - seen)
    if missing:
        logging.warning('Host(s) missing from PLAY RECAP, defaulting to failed: %s', missing)

    return results


# ─── per-host state writing ────────────────────────────────────────────────────

def ensure_host_dir(hostname, config):
    host_dir = os.path.join(config['hosts_base_path'], hostname)
    os.makedirs(host_dir, exist_ok=True)
    return host_dir


def write_host_log(hostname, content, config):
    host_dir = ensure_host_dir(hostname, config)
    dest_path = os.path.join(host_dir, config['log_filename'])
    tmp_path = os.path.join(config['tmp_path'], 'log_{}.tmp'.format(hostname))
    logging.debug('[%s] Writing execution log: %s', hostname, dest_path)
    try:
        with open(tmp_path, 'w') as f:
            f.write(content)
        os.replace(tmp_path, dest_path)
        logging.info('[%s] Log written: %s (%d byte(s))', hostname, dest_path, len(content))
    except OSError as e:
        logging.error('[%s] Failed to write log %s: %s', hostname, dest_path, e)


def read_host_metadata(hostname, config):
    host_dir = os.path.join(config['hosts_base_path'], hostname)
    metadata_path = os.path.join(host_dir, config['metadata_filename'])
    if not os.path.exists(metadata_path):
        logging.debug('[%s] No existing metadata file at %s, starting fresh', hostname, metadata_path)
        return {'status': '', 'last_execution': None}
    try:
        with open(metadata_path, 'r') as f:
            data = yaml.safe_load(f) or {}
    except (OSError, yaml.YAMLError) as e:
        logging.warning('[%s] Could not read existing metadata %s (%s), starting fresh',
                        hostname, metadata_path, e)
        return {'status': '', 'last_execution': None}
    data.setdefault('status', '')
    data.setdefault('last_execution', None)
    return data


def write_host_metadata_file(hostname, data, config):
    host_dir = ensure_host_dir(hostname, config)
    dest_path = os.path.join(host_dir, config['metadata_filename'])
    tmp_path = os.path.join(config['tmp_path'], 'metadata_{}.tmp'.format(hostname))
    logging.debug('[%s] Writing metadata to %s: %s', hostname, dest_path, data)
    try:
        with open(tmp_path, 'w') as f:
            yaml.safe_dump(data, f, sort_keys=False, default_flow_style=False)
        os.replace(tmp_path, dest_path)
        logging.info('[%s] Metadata written: %s', hostname, dest_path)
    except OSError as e:
        logging.error('[%s] Failed to write metadata %s: %s', hostname, dest_path, e)


def write_host_status(hostname, status_message, config):
    """Update just the status field for a host, preserving its last_execution record.

    Used for every transient status the operator can see: 'Scheduled', 'Running', and the
    empty-group/missing-profile explanations. Callers are responsible for logging at the
    appropriate level for their own case (INFO for progress, WARNING/ERROR for a real problem).
    """
    logging.debug('[%s] Setting status to: %s', hostname, status_message)
    data = read_host_metadata(hostname, config)
    data['status'] = status_message
    write_host_metadata_file(hostname, data, config)


def write_host_execution_metadata(hostname, execution_info, config):
    """Record a real execution: status becomes Completed/Failed, last_execution replaced wholesale."""
    status = 'Completed' if execution_info.get('success') else 'Failed'
    data = {
        'status': status,
        'last_execution': execution_info,
    }
    write_host_metadata_file(hostname, data, config)


# ─── orchestration ──────────────────────────────────────────────────────────────

def process_group(fn_group, entry, stale_hosts, conf, inventory_checksum, config):
    logging.info('[%s] %d stale host(s): %s', fn_group, len(stale_hosts), sorted(stale_hosts))

    profiles = entry.get('profiles', []) or []
    roles = entry.get('roles', {}) or {}

    if not profiles and not roles:
        message = 'No profile or roles associated with the host function group'
        logging.warning('[%s] %s - skipping this cycle', fn_group, message)
        for hostname in stale_hosts:
            write_host_status(hostname, message, config)
        return

    role_list, error_message = resolve_group_roles(conf, entry, fn_group)
    if error_message:
        logging.error('[%s] Skipping group this cycle: %s', fn_group, error_message)
        for hostname in stale_hosts:
            write_host_status(hostname, 'Error: {}'.format(error_message), config)
        return

    playbook_path = generate_group_playbook(fn_group, role_list, config)

    logging.info('[%s] Marking %d host(s) as Running', fn_group, len(stale_hosts))
    for hostname in stale_hosts:
        write_host_status(hostname, 'Running', config)

    execution = run_group_playbook(fn_group, playbook_path, stale_hosts, inventory_checksum, config)

    for hostname in stale_hosts:
        write_host_log(hostname, execution['output'], config)
        write_host_execution_metadata(hostname, {
            'time': execution['end_time'].isoformat(),
            'command': execution['command'],
            'success': execution['per_host_success'].get(hostname, False),
            'inventory_checksum': inventory_checksum,
            'inventory_path': config['inventory_path'],
        }, config)

    succeeded = sum(1 for v in execution['per_host_success'].values() if v)
    logging.info('[%s] Group execution complete: %d/%d host(s) succeeded',
                 fn_group, succeeded, len(stale_hosts))


def run_full_pass(conf, current_config, inventory_checksum, config):
    function_groups_conf = conf.get('function_groups', {})
    function_groups_current = current_config.get('function_groups', {})

    logging.info('Starting full pass: %d configured function group(s), inventory checksum=%s',
                 len(function_groups_current), inventory_checksum)

    all_hosts = set()
    for fn_group in function_groups_current:
        group_hosts = function_groups_conf.get(fn_group, [])
        if not group_hosts:
            logging.debug('[%s] Group has no members in the current inventory snapshot', fn_group)
        all_hosts.update(group_hosts)

    if not all_hosts:
        logging.info('No hosts to check this pass: no configured function group currently has members')
        return

    remote_checksums = check_hosts_threaded(sorted(all_hosts), config)

    # Compute every group's stale hosts up front, so we can mark them all "Scheduled" before any
    # group actually starts executing. Groups run sequentially and a push can take a long time,
    # so a host queued behind another group's execution would otherwise show no status at all
    # for the whole time it's waiting its turn.
    stale_by_group = {}
    for fn_group, entry in function_groups_current.items():
        group_hosts = function_groups_conf.get(fn_group, [])
        if not group_hosts:
            logging.debug('[%s] Skipping: no members in current inventory', fn_group)
            continue

        stale_hosts = [h for h in group_hosts if remote_checksums.get(h) != inventory_checksum]
        if not stale_hosts:
            logging.debug('[%s] All %d host(s) already up to date', fn_group, len(group_hosts))
            continue

        stale_by_group[fn_group] = (entry or {}, stale_hosts)

    if not stale_by_group:
        logging.info('No stale hosts this pass, nothing to schedule')
        return

    all_stale_hosts = sorted({h for _, hosts in stale_by_group.values() for h in hosts})
    logging.info('Marking %d stale host(s) as Scheduled ahead of execution: %s',
                 len(all_stale_hosts), all_stale_hosts)
    for hostname in all_stale_hosts:
        write_host_status(hostname, 'Scheduled', config)

    for fn_group, (entry, stale_hosts) in stale_by_group.items():
        try:
            process_group(fn_group, entry, stale_hosts, conf, inventory_checksum, config)
        except Exception as e:
            logging.error('[%s] Unhandled exception while processing group: %s', fn_group, e,
                          exc_info=True)

    logging.info('Full pass complete')


# ─── main loop ──────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description='BlueBanquise cluster playbooks daemon')
    parser.add_argument('config', help='Path to YAML configuration file')
    parser.add_argument('--log-level', default=None,
                        help='Override log level from config (DEBUG, INFO, WARNING, ERROR)')
    args = parser.parse_args()

    setup_logging(args.log_level or 'INFO')
    logging.info('BlueBanquise cluster playbooks daemon starting')

    config = load_daemon_config(args.config)

    if not args.log_level:
        setup_logging(config.get('log_level', 'INFO'))

    loop_interval = config.get('loop_interval', 30)
    host_check_interval = config.get('host_check_interval', 900)

    logging.info('Loop interval:        %ds', loop_interval)
    logging.info('Host check interval:  %ds', host_check_interval)
    logging.info('Thread pool size:     %d', config.get('thread_pool_size', 100))
    logging.info('SSH timeout:          %ds', config.get('ssh_timeout', 10))
    logging.info('Inventory path:       %s', config.get('inventory_path'))
    logging.info('ansible-playbook bin: %s', config.get('ansible_playbook_bin'))
    logging.info('ansible.cfg path:     %s', config.get('ansible_config_path'))
    logging.info('Host tag path:        %s', config.get('host_tag_path'))
    logging.info('Catalog conf path:    %s', config.get('conf_path'))
    logging.info('current_config path:  %s', config.get('current_config_path'))
    logging.info('Playbooks path:       %s', config.get('playbooks_path'))
    logging.info('Hosts base path:      %s', config.get('hosts_base_path'))

    last_processed_checksum = None
    last_host_check_time = 0.0

    while True:
        loop_start = time.monotonic()

        logging.debug('Tick: computing inventory checksum for %s', config['inventory_path'])
        try:
            current_checksum = compute_inventory_checksum(config['inventory_path'])
        except OSError as e:
            logging.error('Failed to compute inventory checksum: %s', e)
            current_checksum = None

        now = time.monotonic()
        time_since_last_check = now - last_host_check_time

        if current_checksum is None:
            should_run_full_pass = False
            logging.warning('Skipping this tick: could not read the inventory folder')
        elif last_processed_checksum is None:
            should_run_full_pass = True
            logging.info('First tick since daemon start: running a full pass')
        elif current_checksum != last_processed_checksum:
            should_run_full_pass = True
            logging.info('Inventory checksum changed (%s -> %s): running a full pass',
                         last_processed_checksum, current_checksum)
        elif time_since_last_check >= host_check_interval:
            should_run_full_pass = True
            logging.info('Host check interval elapsed (%.0fs >= %ds since last full pass): '
                         'running a full pass', time_since_last_check, host_check_interval)
        else:
            should_run_full_pass = False
            logging.debug('Inventory checksum unchanged (%s), only %.0fs/%ds since last full '
                          'pass - skipping the host-check phase this tick',
                          current_checksum, time_since_last_check, host_check_interval)

        if should_run_full_pass:
            try:
                conf = load_conf(config['conf_path'])
                current_config = load_current_config(config['current_config_path'])
                run_full_pass(conf, current_config, current_checksum, config)
                last_processed_checksum = current_checksum
                last_host_check_time = time.monotonic()
            except Exception as e:
                logging.error('Unhandled exception during full pass: %s', e, exc_info=True)

        elapsed = time.monotonic() - loop_start
        sleep_time = max(0.0, loop_interval - elapsed)
        if sleep_time > 0:
            logging.debug('Tick complete in %.2fs, sleeping %.2fs', elapsed, sleep_time)
            time.sleep(sleep_time)
        else:
            logging.warning('Tick took %.1fs, exceeding loop interval of %ds - starting next '
                            'tick immediately', elapsed, loop_interval)


if __name__ == '__main__':
    main()
