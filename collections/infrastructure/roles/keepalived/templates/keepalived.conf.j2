#jinja2: lstrip_blocks: True
{{ ansible_managed | comment }}
{# Only instances listing this host in their servers are written #}
{% for instance in keepalived_vrrp_instances %}
{%   if inventory_hostname in instance.servers %}
{%     set instance_id = instance.id | default(77 + loop.index, true) %}

vrrp_instance {{ instance.name | default('BB_VI_' ~ (instance.id | default(loop.index, true)), true) }} {

  virtual_router_id {{ instance_id }}

{%     if inventory_hostname == instance.servers[0] %}
  state MASTER
  priority 100
{%     else %}
  state BACKUP
  priority {{ 90 - (instance.servers.index(inventory_hostname) + 1) }}
{%     endif %}

  # Check interval
  advert_int {{ instance.advert_int | default(1, true) }}

  # Synchro interface between hosts
  interface {{ instance.interface }}

  # Authentication between hosts
  authentication {
    auth_type PASS
    auth_pass {{ instance.auth_pass }}
  }

  # Virtual IPs
  virtual_ipaddress {
{%     for vip in instance.virtual_ipaddress %}
    {{ vip }}
{%     endfor %}
  }
}
{%   endif %}
{% endfor %}
