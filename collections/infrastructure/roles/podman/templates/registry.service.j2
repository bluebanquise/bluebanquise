{{ ansible_managed | comment }}
[Unit]
Description=Local container registry
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=on-failure
TimeoutStopSec=62
ExecStartPre=/bin/rm -f %t/%n.ctr-id
ExecStart=/usr/bin/podman run --cidfile=%t/%n.ctr-id --sdnotify=conmon --cgroups=no-conmon --rm --replace --name=registry -p {{ podman_local_registry_port }}:5000 -v {{ podman_local_registry_dir }}:/var/lib/registry:Z {{ podman_registry_container }}:{{ podman_registry_container_tag }}
ExecStop=/usr/bin/podman stop -t 2 --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm -f --ignore --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=multi-user.target
