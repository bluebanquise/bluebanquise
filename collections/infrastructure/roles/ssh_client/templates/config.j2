#jinja2: lstrip_blocks: True
{{ ansible_managed | comment }}

{% set options = {
  'ssh_client_stricthostkeychecking': 'StrictHostKeyChecking',
  'ssh_client_userknownhostsfile': 'UserKnownHostsFile',
  'ssh_client_loglevel': 'LogLevel',
  'ssh_client_verifyhostkeydns': 'VerifyHostKeyDNS',
  'ssh_client_forwardx11trusted': 'ForwardX11Trusted',
  'ssh_client_user': 'User'
} %}
{% if ssh_client_custom_config is defined and ssh_client_custom_config is not none %}
{{ ssh_client_custom_config }}

{% endif %}
{# Hosts specific parameters, written only for hosts having at least one #}
{% for host in groups[ssh_client_restrict_to_group | default(bb_restrict_to_group, true) | default('all', true)] %}
  {% set host_network = hostvars[host]['ssh_client_network'] | default(ssh_client_global_network, true) | default(none, true) %}
  {% set ns = namespace(lines=[]) %}
  {% if host_network is not none %}
    {% set ns.lines = ns.lines + ['Hostname %h-' ~ host_network] %}
  {% endif %}
  {% for variable, option in options.items() %}
    {% if hostvars[host][variable] is defined and hostvars[host][variable] is not none %}
      {% set ns.lines = ns.lines + [option ~ ' ' ~ hostvars[host][variable]] %}
    {% endif %}
  {% endfor %}
  {% if ns.lines | length > 0 %}
Host {{ host }}
    {% for line in ns.lines %}
    {{ line }}
    {% endfor %}

  {% endif %}
{% endfor %}
{# Global parameters, after hosts ones, as ssh uses the first value found for each option #}
{% set ns = namespace(lines=[]) %}
{% for variable, option in options.items() if variable != 'ssh_client_user' %}
  {% if lookup('ansible.builtin.vars', variable | replace('ssh_client_', 'ssh_client_global_'), default=none) is not none %}
    {% set ns.lines = ns.lines + [option ~ ' ' ~ lookup('ansible.builtin.vars', variable | replace('ssh_client_', 'ssh_client_global_'))] %}
  {% endif %}
{% endfor %}
{% if ns.lines | length > 0 %}
Host *
  {% for line in ns.lines %}
    {{ line }}
  {% endfor %}
{% endif %}
