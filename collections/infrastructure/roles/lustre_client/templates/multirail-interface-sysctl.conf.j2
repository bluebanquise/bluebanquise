{{ ansible_managed | comment }}
# Settings needed by LNET multi-rail, see Lustre manual
net.ipv4.conf.all.rp_filter = 0
{% for interface in lustre_client_lnet_interfaces %}
{# VLAN interfaces (ib0.8001) are written with a / in sysctl keys #}
{%   set key = interface | replace('.', '/') %}
net.ipv4.conf.{{ key }}.accept_local = 1
net.ipv4.conf.{{ key }}.arp_ignore = 1
net.ipv4.conf.{{ key }}.arp_filter = 0
net.ipv4.conf.{{ key }}.arp_announce = 2
net.ipv4.conf.{{ key }}.rp_filter = 0
{% endfor %}
