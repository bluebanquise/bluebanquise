    return os.path.join(tool_paths['bootstrap_images_tmp'], image_source_file_name)


def get_bootstrap_image_path(tool_paths, bootstrap_image_name):
    return os.path.join(tool_paths['bootstrap_images'], bootstrap_image_name)


def get_reference_image_nfs_path(tool_paths, reference_image_name):
    return os.path.join(tool_paths['nfs'], reference_image_name)


def get_reference_image_pxe_path(tool_paths, reference_image_name):
    return os.path.join(tool_paths['http_pxe_diskless'], reference_image_name)


def get_live_image_path(tool_paths, live_image_name):
    return os.path.join(tool_paths['http_pxe_diskless'], live_image_name)


def load_tool_parameters():
    logging.info(bcolors.OKBLUE + 'Loading parameters from ' + DISKLESS_CONFIG_FILE + '...' + bcolors.ENDC)
    try:
        with open(DISKLESS_CONFIG_FILE, 'r') as file:
            return yaml.safe_load(file)
    except FileNotFoundError:
        logging.error(bcolors.FAIL + 'File ' + DISKLESS_CONFIG_FILE +
                      ' does not exist, please re-run pxe_stack role before using the tool.' + bcolors.ENDC)
        sys.exit(1)
    except Exception as e:
        logging.error(bcolors.FAIL + 'An error occurred reading ' + DISKLESS_CONFIG_FILE + ': ' + str(e) + bcolors.ENDC)
        sys.exit(1)


def build_tool_paths(tool_parameters):
    tool_paths = {}
    tool_paths['bootstrap_images'] = os.path.join(tool_parameters['sudo_user_home'], 'diskless/bootstrap_images')
    tool_paths['bootstrap_images_tmp'] = os.path.join(tool_paths['bootstrap_images'], 'tmp')
    tool_paths['http_pxe_diskless'] = os.path.join(tool_parameters['http_pxe_folder'], 'diskless')
    tool_paths['nfs'] = tool_parameters['nfs_path']
    return tool_paths


def ensure_folders(tool_paths, debug=False):
    logging.info(bcolors.OKBLUE + 'Checking folders exist...' + bcolors.ENDC)
    if not os.path.exists(tool_paths['bootstrap_images']):
        logging.info(bcolors.OKBLUE + 'Creating ' + tool_paths['bootstrap_images'] + ' folder.' + bcolors.ENDC)
        protected_os_system('mkdir -p ' + tool_paths['bootstrap_images_tmp'], debug=debug)
    if not os.path.exists(tool_paths['nfs']):
        logging.info(bcolors.OKBLUE + 'Creating ' + tool_paths['nfs'] + ' folder.' + bcolors.ENDC)
        protected_os_system('mkdir -p ' + tool_paths['nfs'], debug=debug)
    if not os.path.exists(tool_paths['http_pxe_diskless']):
        logging.info(bcolors.OKBLUE + 'Creating ' + tool_paths['http_pxe_diskless'] + ' folder.' + bcolors.ENDC)
        protected_os_system('mkdir -p ' + tool_paths['http_pxe_diskless'], debug=debug)


# ─── actions ────────────────────────────────────────────────────────────────

def cmd_list(args, tool_paths, tool_parameters):
    types = [args.type] if args.type else ['bootstrap', 'reference', 'live']
    for image_type in types:
        display_images(image_type, tool_paths)
    return 0


def cmd_bootstrap_import(args, tool_paths, tool_parameters):
    protected_os_system('mkdir -p ' + tool_paths['bootstrap_images_tmp'], debug=args.debug)
    logging.info(bcolors.OKBLUE + 'Image will be temporarily stored inside ' +
                 tool_paths['bootstrap_images_tmp'] + bcolors.ENDC)

    if args.local:
        if not os.path.isfile(args.local):
            logging.error(bcolors.FAIL + 'Local bootstrap archive not found: ' + args.local + bcolors.ENDC)
            sys.exit(1)
        image_source_file_name = os.path.basename(args.local)
        tmp_image_source_path = get_tmp_image_source_path(tool_paths, image_source_file_name)
        logging.info(bcolors.OKBLUE + 'Copying image from ' + args.local + ', please be patient...' + bcolors.ENDC)
        protected_os_system('cp ' + args.local + ' ' + tmp_image_source_path, debug=args.debug)
    else:
        image_source_file_name = args.url.split('/')[-1]
        tmp_image_source_path = get_tmp_image_source_path(tool_paths, image_source_file_name)
        logging.info(bcolors.OKBLUE + 'Downloading image from ' + args.url + ', please be patient...' + bcolors.ENDC)
        try:
            urllib.request.urlretrieve(args.url, tmp_image_source_path, reporthook=download_progress)
            print('')
        except Exception as e:
            print('')
            logging.error(bcolors.FAIL + 'Download failed: ' + str(e) + bcolors.ENDC)
            if os.path.isfile(tmp_image_source_path):
                logging.info('Removing partial download: ' + tmp_image_source_path)
                os.remove(tmp_image_source_path)
            sys.exit(1)

    logging.info(bcolors.OKBLUE + 'Extracting image metadata...' + bcolors.ENDC)
    protected_os_system('rm -f ' + os.path.join(tool_paths['bootstrap_images_tmp'], 'metadata.yaml'), debug=args.debug)
    protected_os_system('tar xzf ' + tmp_image_source_path + ' -C ' + tool_paths['bootstrap_images_tmp'] + '/ metadata.yaml',
                         debug=args.debug)
    image_metadata = read_metadata(tool_paths['bootstrap_images_tmp'])

    # image_metadata['name'] comes from archive content, which for --url is remote/untrusted;
    # validate before it is ever used in a shell command or filesystem path.
    try:
        validate_name(str(image_metadata.get('name', '')))
    except ValueError as e:
        logging.error(bcolors.FAIL + 'Invalid image name in archive metadata: ' + str(e) + bcolors.ENDC)
        sys.exit(1)

    logging.info('Found following metadata for new image:')
    display_image_metadata(image_metadata)
    bootstrap_image_path = get_bootstrap_image_path(tool_paths, image_metadata['name'])
    ensure_target_ready(bootstrap_image_path, args.force)

    logging.info(bcolors.OKBLUE + 'Storing image...' + bcolors.ENDC)
    protected_os_system('mkdir -p ' + bootstrap_image_path, debug=args.debug)
    protected_os_system('mv ' + tmp_image_source_path + ' ' + os.path.join(bootstrap_image_path, 'image.tar.gz'),
                         debug=args.debug)
    protected_os_system('mv ' + os.path.join(tool_paths['bootstrap_images_tmp'], 'metadata.yaml') + ' ' +
                         os.path.join(bootstrap_image_path, 'metadata.yaml'), debug=args.debug)
    logging.info(bcolors.OKGREEN + 'Bootstrap image ' + image_metadata['name'] + ' is now ready to be used.' + bcolors.ENDC)
    return 0


def cmd_reference_create(args, tool_paths, tool_parameters):
    bootstrap_image_path = get_bootstrap_image_path(tool_paths, args.bootstrap)
    image_metadata = read_metadata(bootstrap_image_path)
    image_metadata['reference_name'] = image_metadata['name']
    image_metadata['name'] = args.new_name
    image_metadata['type'] = 'nfs_reference'

    reference_image_nfs_path = get_reference_image_nfs_path(tool_paths, args.new_name)
    reference_image_pxe_path = get_reference_image_pxe_path(tool_paths, args.new_name)
    ensure_target_ready(reference_image_nfs_path, args.force)
    ensure_target_ready(reference_image_pxe_path, args.force)

    logging.info(bcolors.OKBLUE + 'Extracting bootstrap image copy in ' + reference_image_nfs_path + bcolors.ENDC)
    protected_os_system('mkdir -p ' + reference_image_nfs_path, debug=args.debug)
    protected_os_system('tar --numeric-owner -x -z -f ' + os.path.join(bootstrap_image_path, 'image.tar.gz') +
                         ' -C ' + reference_image_nfs_path + '/', debug=args.debug)
    protected_os_system('rm -f ' + os.path.join(reference_image_nfs_path, 'metadata.yaml'), debug=args.debug)

    logging.info(bcolors.OKBLUE + 'Creating image folder at ' + reference_image_pxe_path + bcolors.ENDC)
    protected_os_system('mkdir -p ' + reference_image_pxe_path, debug=args.debug)

    copy_kernel_files(image_metadata['family'], image_metadata['kernel'],
                       reference_image_nfs_path, reference_image_pxe_path, debug=args.debug)

    ipxe_content = render_boot_ipxe('nfs', image_metadata['name'], image_metadata['kernel'], tool_parameters['nfs_path'])
    write_boot_ipxe(reference_image_pxe_path, ipxe_content)
    write_metadata(reference_image_pxe_path, image_metadata)

    logging.info(bcolors.OKGREEN + 'Reference image has been created.' + bcolors.ENDC)
    logging.info('You can now edit the image directly inside ' + reference_image_nfs_path)
    logging.info('Or link it to a node for live tuning using the reference-link subcommand.')
    return 0


def cmd_reference_link(args, tool_paths, tool_parameters):
    reference_image_nfs_path = get_reference_image_nfs_path(tool_paths, args.image)
    if not os.path.isdir(reference_image_nfs_path):
        logging.error(bcolors.FAIL + 'Reference image not found: ' + reference_image_nfs_path + bcolors.ENDC)
        sys.exit(1)

    if args.password_file:
        try:
            with open(args.password_file, 'r') as file:
                password = file.readline().rstrip('\n')
        except Exception as e:
            logging.error(bcolors.FAIL + 'Unable to read password file ' + args.password_file + ': ' + str(e) + bcolors.ENDC)
            sys.exit(1)
    else:
        password = getpass.getpass('Temporary password for image internal bluebanquise user: ')

    if not password:
        logging.error(bcolors.FAIL + 'Password cannot be empty.' + bcolors.ENDC)
        sys.exit(1)

    hashed_password = hash_password(password)

    logging.info(bcolors.OKBLUE + 'Adding bluebanquise user to image...' + bcolors.ENDC)
    protected_os_system('mkdir -p ' + reference_image_nfs_path + os.path.dirname(tool_parameters['sudo_user_home']),
                         debug=args.debug)

    # Required if host node is running SELinux in enforcing mode
    protected_os_system('mkdir -p ' + reference_image_nfs_path + '/sys/fs/selinux', debug=args.debug)
    protected_os_system("echo '0' > " + reference_image_nfs_path + '/sys/fs/selinux/enforce', debug=args.debug)

    sudo_user = tool_parameters['sudo_user']
    sudo_user_home = tool_parameters['sudo_user_home']
    sudo_user_uid = tool_parameters['sudo_user_uid']

    # create group in image, skip if already created
    protected_os_system(
        "/usr/bin/grep -q '^" + sudo_user + ":' " + reference_image_nfs_path + '/etc/group' +
        ' || /usr/sbin/groupadd -R ' + reference_image_nfs_path + '/ --system ' + sudo_user,
        debug=args.debug)

    # useradd should use "-g", but this fails in RHEL8 hosts
    group_str = '' if 'el8' in platform.release() else ('-g ' + sudo_user)

    # create user in image, skip if already created
    protected_os_system(
        "/usr/bin/grep -q '^" + sudo_user + ":' " + reference_image_nfs_path + '/etc/passwd' +
        ' || /usr/sbin/useradd  -R ' + reference_image_nfs_path + "/ -m -c 'BlueBanquise user' " + group_str +
        ' -d ' + sudo_user_home + ' --system -u ' + str(sudo_user_uid) +
        " -s /bin/bash -p '" + hashed_password + "' " + sudo_user,
        debug=args.debug)

    # update of user password in image, useful if previous command was skipped
    logging.info(bcolors.OKBLUE + 'Setting password of ' + sudo_user + ' user in image...' + bcolors.ENDC)
    protected_os_system("/usr/sbin/usermod -P " + reference_image_nfs_path + " -p '" + hashed_password + "' " + sudo_user,
                         debug=args.debug)

    protected_os_system("echo '" + sudo_user + " ALL=(ALL:ALL) NOPASSWD:ALL' > " +
                         reference_image_nfs_path + '/etc/sudoers.d/' + sudo_user, debug=args.debug)

    logging.info(bcolors.OKBLUE + 'Updating /etc/exports...' + bcolors.ENDC)
    protected_os_system("cat /etc/exports | grep '# diskless' || echo '# diskless' | tee -a /etc/exports",
                         debug=args.debug)
    protected_os_system(
        "cat /etc/exports | grep '" + reference_image_nfs_path + "' && sed -i 's/\\/nfs\\/diskless\\/" + args.image +
        "\\ .*/\\/nfs\\/diskless\\/" + args.image + ' ' + args.node + "(rw,no_root_squash)/' /etc/exports || " +
        "sed -i -e '$a" + reference_image_nfs_path + ' ' + args.node + "(rw,no_root_squash)' /etc/exports",
        debug=args.debug)

    logging.info(bcolors.OKBLUE + 'Restarting nfs server service...' + bcolors.ENDC)
    protected_os_system('systemctl restart nfs-server', debug=args.debug)

    logging.info(bcolors.OKGREEN + 'Image linked to the node.' + bcolors.ENDC)
    logging.info('Boot the node and tune the image as needed.')
    logging.info('Set the node next boot on this image using:')
    logging.info('  bluebanquise-bootset -b diskless -i ' + args.image + ' -n ' + args.node)
    logging.info("If using BlueBanquise Ansible roles, skip-tags 'identify' and 'secret'.")
    return 0


def cmd_reference_list_kernels(args, tool_paths, tool_parameters):
    reference_image_nfs_path = get_reference_image_nfs_path(tool_paths, args.image)
    modules_path = os.path.join(reference_image_nfs_path, 'usr', 'lib', 'modules')
    if not os.path.isdir(modules_path):
        logging.error(bcolors.FAIL + 'Reference image or its kernel modules not found: ' + modules_path + bcolors.ENDC)
        sys.exit(1)

    print('Detected kernels for ' + args.image + ':')
    for it in sorted(os.scandir(modules_path), key=lambda e: e.name):
        if it.is_dir():
            print('  - ' + it.name)
    return 0


def cmd_reference_set_kernel(args, tool_paths, tool_parameters):
    reference_image_nfs_path = get_reference_image_nfs_path(tool_paths, args.image)
    reference_image_pxe_path = get_reference_image_pxe_path(tool_paths, args.image)

    kernel_modules_path = os.path.join(reference_image_nfs_path, 'usr', 'lib', 'modules', args.kernel)
    if not os.path.isdir(kernel_modules_path):
        logging.error(bcolors.FAIL + 'Kernel ' + args.kernel + ' not found under ' + kernel_modules_path + bcolors.ENDC)
        sys.exit(1)

    image_metadata = read_metadata(reference_image_pxe_path)

    logging.info(bcolors.OKBLUE + 'Copying new kernel from NFS image to http folder...' + bcolors.ENDC)
    copy_kernel_files(image_metadata['family'], args.kernel, reference_image_nfs_path, reference_image_pxe_path,
                       debug=args.debug)

    logging.info(bcolors.OKBLUE + 'Updating image metadata...' + bcolors.ENDC)
    image_metadata['kernel'] = args.kernel
    write_metadata(reference_image_pxe_path, image_metadata)

    logging.info(bcolors.OKBLUE + 'Updating boot.ipxe file...' + bcolors.ENDC)
    ipxe_content = render_boot_ipxe('nfs', image_metadata['name'], args.kernel, tool_parameters['nfs_path'])
    write_boot_ipxe(reference_image_pxe_path, ipxe_content)

    logging.info(bcolors.OKGREEN + 'Kernel ' + args.kernel + ' set as default for next boot.' + bcolors.ENDC)
    logging.info('Restart the node for the change to take effect.')
    return 0


def cmd_reference_clone(args, tool_paths, tool_parameters):
    reference_image_nfs_path = get_reference_image_nfs_path(tool_paths, args.image)
    reference_image_pxe_path = get_reference_image_pxe_path(tool_paths, args.image)
    if not os.path.isdir(reference_image_nfs_path):
        logging.error(bcolors.FAIL + 'Reference image not found: ' + reference_image_nfs_path + bcolors.ENDC)
        sys.exit(1)

    clone_image_nfs_path = get_reference_image_nfs_path(tool_paths, args.new_name)
    clone_image_pxe_path = get_reference_image_pxe_path(tool_paths, args.new_name)
    ensure_target_ready(clone_image_nfs_path, args.force)
    ensure_target_ready(clone_image_pxe_path, args.force)

    logging.info(bcolors.OKBLUE + 'Cloning image...' + bcolors.ENDC)
    protected_os_system('cp -a ' + reference_image_nfs_path + ' ' + clone_image_nfs_path, debug=args.debug)
    protected_os_system('cp -a ' + reference_image_pxe_path + ' ' + clone_image_pxe_path, debug=args.debug)

    logging.info(bcolors.OKBLUE + 'Updating new image metadata...' + bcolors.ENDC)
    image_metadata = read_metadata(clone_image_pxe_path)
    image_metadata['name'] = args.new_name

    ipxe_content = render_boot_ipxe('nfs', image_metadata['name'], image_metadata['kernel'], tool_parameters['nfs_path'])
    write_boot_ipxe(clone_image_pxe_path, ipxe_content)
    write_metadata(clone_image_pxe_path, image_metadata)

    logging.info(bcolors.OKGREEN + 'Image cloned successfully as ' + args.new_name + '.' + bcolors.ENDC)
    return 0


def cmd_live_create(args, tool_paths, tool_parameters):
    reference_image_nfs_path = get_reference_image_nfs_path(tool_paths, args.image)
    reference_image_pxe_path = get_reference_image_pxe_path(tool_paths, args.image)
    if not os.path.isdir(reference_image_nfs_path):
        logging.error(bcolors.FAIL + 'Reference image not found: ' + reference_image_nfs_path + bcolors.ENDC)
        sys.exit(1)

    image_metadata = read_metadata(reference_image_pxe_path)
    image_metadata['reference_name'] = image_metadata['name'] + ',' + image_metadata['reference_name']
    image_metadata['name'] = args.new_name
    image_metadata['type'] = 'live'

    live_image_path = get_live_image_path(tool_paths, args.new_name)
    ensure_target_ready(live_image_path, args.force)

    logging.info(bcolors.OKBLUE + 'Preparing filesystem...' + bcolors.ENDC)
    workdir = os.path.join(live_image_path, 'workdir', 'LiveOS')
    mountdir = os.path.join(live_image_path, 'mountdir')
    rootfs_img = os.path.join(workdir, 'rootfs.img')
    protected_os_system('mkdir -p ' + workdir, debug=args.debug)
    protected_os_system('dd if=/dev/zero of=' + rootfs_img + ' bs=1M count=' + str(args.size_mb), debug=args.debug)
    protected_os_system('mkfs.xfs ' + rootfs_img, debug=args.debug)
    os.makedirs(mountdir)
    protected_os_system('mount -o loop ' + rootfs_img + ' ' + mountdir + '/', debug=args.debug)

    logging.info(bcolors.OKBLUE + 'Copying files from reference image...' + bcolors.ENDC)
    protected_os_system('cp -a ' + reference_image_nfs_path + '/* ' + mountdir + '/', debug=args.debug)
    protected_os_system('umount ' + mountdir + '/', debug=args.debug)

    logging.info(bcolors.OKBLUE + 'Squashing image...' + bcolors.ENDC)
    protected_os_system('mksquashfs ' + os.path.join(live_image_path, 'workdir') + ' ' +
                         os.path.join(live_image_path, 'squashfs.img'), debug=args.debug)
    shutil.rmtree(os.path.join(live_image_path, 'workdir'))

    logging.info(bcolors.OKBLUE + 'Copying kernel and initramfs...' + bcolors.ENDC)
    protected_os_system('cp -a ' + os.path.join(reference_image_pxe_path, 'initramfs*') + ' ' + live_image_path + '/',
                         debug=args.debug)
    protected_os_system('chmod 644 ' + os.path.join(live_image_path, 'initramfs-*'), debug=args.debug)
    protected_os_system('cp -a ' + os.path.join(reference_image_pxe_path, 'vmlinuz*') + ' ' + live_image_path + '/',
                         debug=args.debug)

    ipxe_content = render_boot_ipxe('live', image_metadata['name'], image_metadata['kernel'])
    write_boot_ipxe(live_image_path, ipxe_content)
    write_metadata(live_image_path, image_metadata)

    logging.info(bcolors.OKGREEN + 'Livenet image created.' + bcolors.ENDC)
    logging.info('Boot the node pool with this image using:')
    logging.info('  bluebanquise-bootset -b diskless -i ' + image_metadata['name'] + ' -n mynodes')
    return 0


def cmd_delete(args, tool_paths, tool_parameters):
    if not args.yes:
        logging.error(bcolors.FAIL + 'Refusing to delete without --yes/-y.' + bcolors.ENDC)
        sys.exit(1)

    if args.type == 'bootstrap':
        path = get_bootstrap_image_path(tool_paths, args.name)
        if not os.path.isdir(path):
            logging.error(bcolors.FAIL + 'Bootstrap image not found: ' + path + bcolors.ENDC)
            sys.exit(1)
        logging.info(bcolors.OKBLUE + 'Deleting image...' + bcolors.ENDC)
        shutil.rmtree(path)

    elif args.type == 'reference':
        nfs_path = get_reference_image_nfs_path(tool_paths, args.name)
        pxe_path = get_reference_image_pxe_path(tool_paths, args.name)
        if not os.path.isdir(nfs_path) and not os.path.isdir(pxe_path):
            logging.error(bcolors.FAIL + 'Reference image not found: ' + nfs_path + bcolors.ENDC)
            sys.exit(1)
        logging.info(bcolors.OKBLUE + 'Deleting image...' + bcolors.ENDC)
        if os.path.isdir(nfs_path):
            shutil.rmtree(nfs_path)
        if os.path.isdir(pxe_path):
            shutil.rmtree(pxe_path)

    else:  # live
        path = get_live_image_path(tool_paths, args.name)
        if not os.path.isdir(path):
            logging.error(bcolors.FAIL + 'Live image not found: ' + path + bcolors.ENDC)
            sys.exit(1)
        logging.info(bcolors.OKBLUE + 'Deleting image...' + bcolors.ENDC)
        shutil.rmtree(path)

    logging.info(bcolors.OKGREEN + 'Image deleted.' + bcolors.ENDC)
    return 0


# ─── argument parsing ─────────────────────────────────────────────────────────

def build_parser():
    parent_parser = argparse.ArgumentParser(add_help=False)
    parent_parser.add_argument('-d', '--debug', action='store_true',
                                help='Print every shell command executed.')
    parent_parser.add_argument('-q', '--quiet', action='store_true',
                                help='Do not print INFO messages.')

    parser = argparse.ArgumentParser(
        description='BlueBanquise diskless tool - manage diskless image lifecycle '
                     '(bootstrap -> reference -> live).',
        parents=[parent_parser])
    subparsers = parser.add_subparsers(dest='command', required=True)

    p_list = subparsers.add_parser('list', parents=[parent_parser], help='List existing images.')
    p_list.add_argument('--type', choices=['bootstrap', 'reference', 'live'],
                         help='Restrict listing to one image type (default: all).')
    p_list.set_defaults(func=cmd_list)

    p_bootstrap_import = subparsers.add_parser(
        'bootstrap-import', parents=[parent_parser], help='Import a new bootstrap image.')
    source_group = p_bootstrap_import.add_mutually_exclusive_group(required=True)
    source_group.add_argument('--local', metavar='PATH', help='Local tar.gz archive path.')
    source_group.add_argument('--url', metavar='URL', help='URL of a tar.gz archive to download.')
    p_bootstrap_import.add_argument('--force', action='store_true',
                                     help='Overwrite an existing bootstrap image of the same name.')
    p_bootstrap_import.set_defaults(func=cmd_bootstrap_import)

    p_reference_create = subparsers.add_parser(
        'reference-create', parents=[parent_parser], help='Create a reference image from a bootstrap image.')
    p_reference_create.add_argument('--bootstrap', required=True, type=validate_name,
                                     help='Source bootstrap image name.')
    p_reference_create.add_argument('--new-name', required=True, type=validate_name,
                                     help='Name of the new reference image.')
    p_reference_create.add_argument('--force', action='store_true',
                                     help='Overwrite an existing reference image of the same name.')
    p_reference_create.set_defaults(func=cmd_reference_create)

    p_reference_link = subparsers.add_parser(
        'reference-link', parents=[parent_parser],
        help='Link a reference image to a node for temporary NFS diskless tuning.')
    p_reference_link.add_argument('--image', required=True, type=validate_name, help='Reference image name.')
    p_reference_link.add_argument('--node', required=True, type=validate_name, help='Target node name.')
    p_reference_link.add_argument('--password-file', metavar='FILE',
                                   help='File containing the temporary password (first line). '
                                        'If omitted, prompted interactively (hidden input).')
    p_reference_link.set_defaults(func=cmd_reference_link)

    p_reference_list_kernels = subparsers.add_parser(
        'reference-list-kernels', parents=[parent_parser], help='List kernels available inside a reference image.')
    p_reference_list_kernels.add_argument('--image', required=True, type=validate_name, help='Reference image name.')
    p_reference_list_kernels.set_defaults(func=cmd_reference_list_kernels)

    p_reference_set_kernel = subparsers.add_parser(
        'reference-set-kernel', parents=[parent_parser], help='Set the default boot kernel of a reference image.')
    p_reference_set_kernel.add_argument('--image', required=True, type=validate_name, help='Reference image name.')
    p_reference_set_kernel.add_argument('--kernel', required=True, type=validate_name,
                                         help='Kernel version, as listed by reference-list-kernels.')
    p_reference_set_kernel.set_defaults(func=cmd_reference_set_kernel)

    p_reference_clone = subparsers.add_parser(
        'reference-clone', parents=[parent_parser], help='Clone a reference image.')
    p_reference_clone.add_argument('--image', required=True, type=validate_name, help='Reference image to clone.')
    p_reference_clone.add_argument('--new-name', required=True, type=validate_name, help='Name of the cloned image.')
    p_reference_clone.add_argument('--force', action='store_true',
                                    help='Overwrite an existing image of the same name.')
    p_reference_clone.set_defaults(func=cmd_reference_clone)

    p_live_create = subparsers.add_parser(
        'live-create', parents=[parent_parser], help='Convert a reference image into a live image.')
    p_live_create.add_argument('--image', required=True, type=validate_name, help='Source reference image name.')
    p_live_create.add_argument('--new-name', required=True, type=validate_name, help='Name of the new live image.')
    p_live_create.add_argument('--size-mb', required=True, type=int, help='Live image RAM size limit, in MB.')
    p_live_create.add_argument('--force', action='store_true',
                                help='Overwrite an existing live image of the same name.')
    p_live_create.set_defaults(func=cmd_live_create)

    p_delete = subparsers.add_parser('delete', parents=[parent_parser], help='Delete an image.')
    p_delete.add_argument('--type', required=True, choices=['bootstrap', 'reference', 'live'],
                           help='Type of image to delete.')
    p_delete.add_argument('--name', required=True, type=validate_name, help='Image name.')
    p_delete.add_argument('-y', '--yes', action='store_true',
                           help='Confirm deletion (required, no interactive prompt).')
    p_delete.set_defaults(func=cmd_delete)

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    loglevel = logging.WARNING if args.quiet else logging.INFO
    logging.basicConfig(format='[%(levelname)s] %(message)s', level=loglevel)

    print("""\

                (o_
      (o_  (o_  //\\
      (/)_ (/)_ V_/_
   BlueBanquise diskless
   v{}
   https://github.com/bluebanquise/bluebanquise/

""".format(VERSION))

    logging.info(bcolors.OKBLUE + 'Checking if user has sufficient rights...' + bcolors.ENDC)
    if os.getuid() != 0:
        print(bcolors.FAIL + 'You need to run this script with sudo or as root.' + bcolors.ENDC)
        sys.exit(1)

    tool_parameters = load_tool_parameters()
    tool_paths = build_tool_paths(tool_parameters)
    ensure_folders(tool_paths, debug=args.debug)

    rc = args.func(args, tool_paths, tool_parameters)

    print(bcolors.HEADER + '\nThank you for using BlueBanquise diskless, have a great day!\n' + bcolors.ENDC)
    sys.exit(rc or 0)


if __name__ == '__main__':
    main()
