# Colors, from https://stackoverflow.com/questions/287871/how-to-print-colored-text-in-terminal-in-python
class bcolors:
    HEADER = '\033[95m'
    OKBLUE = '\033[94m'
    OKGREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'


# ─── validation / helpers ──────────────────────────────────────────────────────

def validate_name(value):
    """Allow-list check for names used in shell commands and filesystem paths (raises ValueError)."""
    if not value:
        raise ValueError('name cannot be empty')
    allowed_characters = set(string.ascii_letters + string.digits + '-_.+')
    invalid_characters = set(value).difference(allowed_characters)
    if invalid_characters:
        first_invalid_char = sorted(invalid_characters)[0]
        raise ValueError("character '{}' is not allowed in '{}'".format(first_invalid_char, value))
    return value


def protected_os_system(raw_command, debug=False):
    if debug:
        print(raw_command)

    try:
        child = subprocess.Popen(raw_command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, shell=True)
        stdout, _ = child.communicate()
        rc = child.returncode
    except Exception as e:
        logging.error(bcolors.FAIL + 'Unable to launch shell command: ' + str(e) + bcolors.ENDC)
        sys.exit(1)

    if rc != 0:
        logging.error(bcolors.FAIL + 'Command failed: ' + raw_command + bcolors.ENDC)
        logging.error('Return code: ' + str(rc))
        logging.error('Output: ' + stdout.decode(errors='replace'))
        logging.error('The tool does not cleanup on failure, so you can investigate; '
                       'remember to cleanup once done.')
        sys.exit(1)
    return 0


def hash_password(password):
    """SHA-512 crypt(3) hash via openssl (stdlib crypt module was removed in Python 3.13)."""
    result = subprocess.run(['openssl', 'passwd', '-6', '-stdin'],
                             input=password.encode(), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode != 0:
        logging.error(bcolors.FAIL + 'openssl passwd failed: ' + result.stderr.decode(errors='replace').strip() + bcolors.ENDC)
        sys.exit(1)
    return result.stdout.decode().strip()


def download_progress(block_count, block_size, total_size):
    downloaded = block_count * block_size
    downloaded_mb = downloaded / (1024 * 1024)
    if total_size > 0:
        percent = min(100, downloaded * 100 // total_size)
        total_mb = total_size / (1024 * 1024)
        sys.stdout.write('\r  Downloading: {:3d}%  {:.1f} MB / {:.1f} MB'.format(
            percent, downloaded_mb, total_mb))
    else:
        sys.stdout.write('\r  Downloading: {:.1f} MB'.format(downloaded_mb))
    sys.stdout.flush()


def render_boot_ipxe(kind, image_name, kernel, nfs_path=None):
    """Render boot.ipxe content for a 'nfs' (reference) or 'live' image."""
    return BOOT_IPXE_TEMPLATES[kind].format(
        image_name=image_name,
        image_kernel='vmlinuz-' + kernel,
        image_initramfs='initramfs-' + kernel + '.img',
        nfs_path=nfs_path)


def copy_kernel_files(family, kernel, nfs_path, pxe_path, debug=False):
    """Copy kernel + initramfs from a reference image's NFS path to its http pxe path."""
    if family not in KNOWN_FAMILIES:
        logging.error(bcolors.FAIL + 'Unknown image family: ' + str(family) + bcolors.ENDC)
        sys.exit(1)

    initramfs_src = os.path.join(nfs_path, 'boot', 'initramfs-' + kernel + '.img')
    initramfs_dst = os.path.join(pxe_path, 'initramfs-' + kernel + '.img')
    protected_os_system('cp -a ' + initramfs_src + ' ' + initramfs_dst, debug=debug)

    if family == 'el8':
        vmlinuz_src = os.path.join(nfs_path, 'boot', 'vmlinuz-' + kernel)
    else:
        vmlinuz_src = os.path.join(nfs_path, 'usr', 'lib', 'modules', kernel, 'vmlinuz')
    vmlinuz_dst = os.path.join(pxe_path, 'vmlinuz-' + kernel)
    protected_os_system('cp -a ' + vmlinuz_src + ' ' + vmlinuz_dst, debug=debug)

    protected_os_system('chmod 644 ' + os.path.join(pxe_path, 'initramfs-*'), debug=debug)
    protected_os_system('chmod 644 ' + os.path.join(pxe_path, 'vmlinuz-*'), debug=debug)


def ensure_target_ready(path, force):
    """Ensure a create-target path doesn't already exist; if --force, wipe it first."""
    if os.path.exists(path):
        if not force:
            logging.error(bcolors.FAIL + path + ' already exists. Use --force to overwrite.' + bcolors.ENDC)
            sys.exit(1)
        logging.warning(bcolors.WARNING + '--force: removing existing ' + path + bcolors.ENDC)
        shutil.rmtree(path)


def read_metadata(path):
    """Read metadata.yaml from a directory. Exit cleanly if missing/unreadable."""
    metadata_file = os.path.join(path, 'metadata.yaml')
    try:
        with open(metadata_file, 'r') as file:
            return yaml.safe_load(file)
    except FileNotFoundError:
        logging.error(bcolors.FAIL + 'File ' + metadata_file +
                      ' does not exist, please re-run pxe_stack role before using the tool.' + bcolors.ENDC)
        sys.exit(1)
    except Exception as e:
        logging.error(bcolors.FAIL + 'An error occurred reading ' + metadata_file + ': ' + str(e) + bcolors.ENDC)
        sys.exit(1)


def write_metadata(path, metadata):
    metadata_file = os.path.join(path, 'metadata.yaml')
    try:
        with open(metadata_file, 'w') as file:
            yaml.dump(metadata, file)
    except Exception as e:
        logging.error(bcolors.FAIL + 'An error occurred writing ' + metadata_file + ': ' + str(e) + bcolors.ENDC)
        sys.exit(1)


def write_boot_ipxe(path, content):
    ipxe_file = os.path.join(path, 'boot.ipxe')
    try:
        with open(ipxe_file, 'w') as file:
            file.write(content)
    except Exception as e:
        logging.error(bcolors.FAIL + 'An error occurred writing ' + ipxe_file + ': ' + str(e) + bcolors.ENDC)
        sys.exit(1)


def display_image_metadata(image_metadata):
    """Print a single image's metadata."""
    print('   └──── name: ' + image_metadata['name'])
    for k, v in image_metadata.items():
        if k not in ('name', 'description'):
            print('          ├─ ' + k + ': ' + str(v))
    print('          └─ description: ' + image_metadata.get('description', ''))


def display_images(image_type, tool_paths):
    """Display existing images of a given type, return 1 if none found."""

    if image_type == 'bootstrap':
        gathered = []
        logging.info(bcolors.OKBLUE + 'Checking bootstrap images in ' + tool_paths['bootstrap_images'] + bcolors.ENDC)
        for it in os.scandir(tool_paths['bootstrap_images']):
            if it.is_dir() and it.name != 'tmp':
                gathered.append(read_metadata(it.path))
        label = 'BOOTSTRAP IMAGES'

    elif image_type == 'reference':
        gathered = []
        logging.info(bcolors.OKBLUE + 'Checking reference images in ' + tool_paths['http_pxe_diskless'] + bcolors.ENDC)
        for it in os.scandir(tool_paths['http_pxe_diskless']):
            if it.is_dir():
                metadata = read_metadata(it.path)
                if metadata.get('type') == 'nfs_reference':
                    gathered.append(metadata)
        label = 'REFERENCE IMAGES'

    else:  # live
        gathered = []
        logging.info(bcolors.OKBLUE + 'Checking live images in ' + tool_paths['http_pxe_diskless'] + bcolors.ENDC)
        for it in os.scandir(tool_paths['http_pxe_diskless']):
            if it.is_dir():
                metadata = read_metadata(it.path)
                if metadata.get('type') == 'live':
                    gathered.append(metadata)
        label = 'LIVE IMAGES'

    if gathered:
        print('')
        print(' ' + label + ':')
        print('   │ ')
        for image in gathered:
            display_image_metadata(image)
        return 0
    else:
        print(' ' + label + ': none found')
        return 1


