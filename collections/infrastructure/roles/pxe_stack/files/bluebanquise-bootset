# bootset edits host iPXE files (<htdocs>/pxe/nodes/<node>.ipxe) directly, so it works even when
# bluebanquise-pxe-stack-daemon is down. Host files are created by the daemon (at startup, or via
# its --bootstrap-only mode run by the pxe_stack Ansible role). Both tools serialize their
# read-modify-write cycles with an exclusive flock on <nodes>/.lock, and write atomically with a
# temporary file created in the same folder (a file moved in from elsewhere would keep its original
# SELinux label, and the http server could not read it). Started as root, bootset drops its
# privileges to the daemon's user before touching anything, so files keep the right owner.

import fcntl
import logging
import os
import pwd
import re
import sys
import yaml
from argparse import ArgumentParser


# Colors, from https://stackoverflow.com/questions/287871/how-to-print-colored-text-in-terminal-in-python
class bcolors:
    HEADER = '\033[95m'
    OKBLUE = '\033[94m'
    OKGREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'


# Built-in boot targets. These match the iPXE menu labels in menu.ipxe.j2 1:1 - no translation
# table needed. Inventory-defined custom entries (pxe_stack_ipxe_menu_custom) are read from
# pxe_parameters.yml and added to this list at runtime, see valid_targets below.
BOOT_OPTIONS = [
    "osdeploy",
    "disk",
    "diskless",
    "next",
    "memtest",
    "alpine",
    "clonezilla",
    "shell",
]


def load_file(filename):
    logging.info(bcolors.OKBLUE+'Loading '+filename+bcolors.ENDC)

    with open(filename, 'r') as f:
        # Select YAML loader (needs PyYAML 5.1+ to be safe)
        if int(yaml.__version__.split('.')[0]) > 5 or (int(yaml.__version__.split('.')[0]) == 5 and int(yaml.__version__.split('.')[1]) >= 1):
            return yaml.load(f, Loader=yaml.FullLoader)
        return yaml.load(f)


def read_host_variables(ipxe_file):
    """Return the 'set <variable> <value>' lines of a host file as a dict."""
    variables = {}
    with open(ipxe_file, 'r') as f:
        for line in f:
            match = re.match(r"^set (\S+)(?: (.*))?$", line.rstrip('\n'))
            if match:
                variables[match.group(1)] = (match.group(2) or '').strip()
    return variables


def set_host_variables(node, ipxe_file, new_values):
    """Replace the matching 'set <variable> ...' lines of a host file, atomically."""
    with open(ipxe_file, 'r') as f:
        filebuffer = f.readlines()
    for i in range(len(filebuffer)):
        for variable, value in new_values.items():
            if re.match(r"^set " + re.escape(variable) + r"( |$)", filebuffer[i]):
                filebuffer[i] = 'set {} {}'.format(variable, value).rstrip() + '\n'
                logging.info('    ├── '+bcolors.OKBLUE+'set '+variable+' '+value+bcolors.ENDC)
    tmp_file = os.path.join(os.path.dirname(ipxe_file), '.' + node + '.ipxe.tmp')
    with open(tmp_file, 'w') as f:
        f.writelines(filebuffer)
    os.chmod(tmp_file, 0o644)
    os.replace(tmp_file, ipxe_file)


def rangeexpand(txt):
    lst = []
    for r in txt.split(','):
        zlen = len(str(r).split('-')[0])
        lstlen_0 = len(lst)
        if '-' in r[1:]:
            r0, r1 = r[1:].split('-', 1)
            lst += range(int(r[0] + r0), int(r1) + 1)
        else:
            lst.append(int(r))
        lstlen_1 = len(lst)
        for i in range(lstlen_0, lstlen_1):
            lst[i] = str(lst[i]).zfill(zlen)
    return lst


def nodesetexpand(znodeset):
    nodeset = []
    for n in znodeset.split(','):
        # supports a single range per element
        if '[' in n and ']' in n:
            n1 = n.split('[')[0]
            n3 = n.split(']')[1]
            for nn in rangeexpand(n.replace(n1 + '[', '').replace(']' + n3, '')):
                nodeset.append(n1 + nn + n3)
        else:
            nodeset.append(n)
    return nodeset


# Get arguments passed to bootset
parser = ArgumentParser()
parser.add_argument("-n", "--nodes", dest="nodes", required=True,
                    help="Target node(s). Use nodeset format for ranges.", metavar="NODE")
parser.add_argument("-s", "--status", dest="status", action="store_true",
                    help="Display current nodes boot target status.")
parser.add_argument("-b", "--boot", dest="boot",
                    help="Next pxe boot sequence: comma-separated list of one or more targets, "
                         "applied in order and auto-advanced by bluebanquise-pxe-stack-daemon as "
                         "each one boots. Built-in: {} (plus any pxe_stack_ipxe_menu_custom "
                         "entries). Example: memtest,osdeploy".format(', '.join(BOOT_OPTIONS)))
parser.add_argument("-i", "--image", dest="image", default="none",
                    help="Specify diskless or clone image to be used.")
parser.add_argument("-e", "--extra-parameters", dest="extra_parameters", default="none",
                    help="Add dedicated kernel parameters for boot chain (osdeploy).")
parser.add_argument("-q", "--quiet", action="store_true",
                    help="Do not print INFO messages.")

# Show help if no argument is supplied
if len(sys.argv) == 1:
    parser.print_help()
    sys.exit(1)

passed_arguments = parser.parse_args()

if not any([passed_arguments.status, passed_arguments.boot]):
    parser.error(bcolors.FAIL + "At least one of --status or --boot must be provided." + bcolors.ENDC)

print("""\

                (o_
      (o_  (o_  //\\
      (/)_ (/)_ V_/_

   BlueBanquise bootset
   v3.0.0
   https://github.com/bluebanquise/bluebanquise/

""")

# Enable logging
loglevel = logging.INFO
if passed_arguments.quiet:
    loglevel = logging.WARNING
logging.basicConfig(format='[%(levelname)s] %(message)s', level=loglevel)

# Load and extract configuration files
pxe_parameters = load_file('/etc/bluebanquise/bootset/pxe_parameters.yml')["pxe_parameters"]

pxe_nodes_path = os.path.join(pxe_parameters["htdocs_path"], 'pxe', 'nodes')
pxe_user = pxe_parameters.get("pxe_user", "bluebanquise-pxe")

custom_entries = pxe_parameters.get('ipxe_menu_custom') or []
valid_targets = BOOT_OPTIONS + list(custom_entries)

# Check we have sufficient privileges, then switch to the daemon's user so files keep their owner
pxe_user_entry = pwd.getpwnam(pxe_user)
if os.getuid() == 0:
    os.setgroups([])
    os.setgid(pxe_user_entry.pw_gid)
    os.setuid(pxe_user_entry.pw_uid)
elif os.getuid() != pxe_user_entry.pw_uid:
    print(bcolors.FAIL + "Admin rights required to run bluebanquise-bootset!" + bcolors.ENDC)
    sys.exit(1)
os.umask(0o022)


if passed_arguments.status:
    by_boot = {}
    unknown = []

    # Iteration on nodes
    for node in nodesetexpand(passed_arguments.nodes):
        # Check if node file exist
        ipxe_file = os.path.join(pxe_nodes_path, '{node}.ipxe'.format(node=node))
        if not os.path.exists(ipxe_file):
            logging.warning(bcolors.WARNING + 'File ' + ipxe_file + ' does not exist. Skipping.' + bcolors.ENDC)
            unknown.append(node)
            continue

        variables = read_host_variables(ipxe_file)
        label = variables.get('menu-default') or 'disk'
        status = variables.get('status') or 'NA'
        if variables.get('status-date'):
            status = status + ' @ ' + variables.get('status-date')
        queue_display = ' -> '.join(variables.get('boot-queue', '').split(',')) or '-'
        if label == 'diskless':
            label = 'diskless (image ' + variables.get('node-image', 'none') + ')'

        if label not in by_boot:
            by_boot[label] = []
        by_boot[label].append((node, status, queue_display))

    # Display nodes per boot target
    for label, nodes in sorted(by_boot.items()):
        print('menu-default={} :'.format(label))
        for node, status, queue_display in nodes:
            print('  {}: [status: {}] [queue: {}]'.format(node, status, queue_display))
        print()
    if unknown:
        print('No host file: {}'.format(','.join(unknown)))

elif passed_arguments.boot:
    boot_queue = [item.strip() for item in passed_arguments.boot.split(',') if item.strip()]
    invalid = [item for item in boot_queue if item not in valid_targets]
    if invalid:
        logging.error(bcolors.FAIL + 'Invalid boot target(s): {}. Valid targets: {}'.format(
            ', '.join(invalid), ', '.join(valid_targets)) + bcolors.ENDC)
        sys.exit(1)

    new_values = {
        'menu-default': boot_queue[0],
        'boot-queue': ','.join(boot_queue),
    }
    # -i/-e default to the sentinel "none", meaning "leave whatever is already set untouched".
    # Never write -e's sentinel: it lands verbatim on a kernel command line.
    if passed_arguments.image != "none":
        new_values['node-image'] = passed_arguments.image
    if passed_arguments.extra_parameters != "none":
        new_values['dedicated-kernel-parameters'] = passed_arguments.extra_parameters
    for value in new_values.values():
        # A line break would let a value inject arbitrary commands into the iPXE script
        if '\n' in value or '\r' in value:
            logging.error(bcolors.FAIL + 'Line breaks are not allowed in values.' + bcolors.ENDC)
            sys.exit(1)

    lock_file = open(os.path.join(pxe_nodes_path, '.lock'), 'a')
    fcntl.flock(lock_file, fcntl.LOCK_EX)

    # Iteration on nodes
    for node in nodesetexpand(passed_arguments.nodes):
        ipxe_file = os.path.join(pxe_nodes_path, '{node}.ipxe'.format(node=node))
        logging.info(bcolors.OKBLUE+'Checking if node '+str(node)+' exist...'+bcolors.ENDC)
        if not os.path.exists(ipxe_file):
            logging.warning(bcolors.WARNING+'File '+ipxe_file+' does not exist (is node in inventory, and pxe_stack role deployed?). Skipping.'+bcolors.ENDC)
            continue
        logging.info(bcolors.OKGREEN+'[OK] Working on node '+str(node)+' ...'+bcolors.ENDC)
        logging.info('    ├── '+bcolors.OKBLUE+'Editing file '+ipxe_file+bcolors.ENDC)
        set_host_variables(node, ipxe_file, new_values)
        logging.info('    └── '+bcolors.OKGREEN+'[OK] Done.'+bcolors.ENDC)

    lock_file.close()
