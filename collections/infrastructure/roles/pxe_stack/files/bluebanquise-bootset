import logging
import os
import sys
import urllib.error
import urllib.request
import yaml
from argparse import ArgumentParser


# Colors
class bcolors:
    HEADER = '\033[95m'
    OKBLUE = '\033[94m'
    OKGREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'


# User-facing boot option names and their corresponding iPXE menu-default labels.
BOOT_OPTIONS = [
    "osdeploy",
    "disk",
    "diskless",
    "next",
    "memtest",
    "alpine",
    "clonezilla",
    "shell",
]

BOOT_LABELS = {
    "osdeploy":   "bootosdeploy",
    "disk":       "bootdisk",
    "diskless":   "bootdiskless",
    "next":       "bootnext",
    "memtest":    "bootmemtest",
    "alpine":     "bootalpinelive",
    "clonezilla": "bootclone",
    "shell":      "startshell",
}

DAEMON_URL = 'http://localhost:7770'
DAEMON_TIMEOUT = 10


def load_file(filename):
    logging.info(bcolors.OKBLUE + 'Loading ' + filename + bcolors.ENDC)
    with open(filename, 'r') as f:
        if int(yaml.__version__.split('.')[0]) > 5 or (
                int(yaml.__version__.split('.')[0]) == 5 and
                int(yaml.__version__.split('.')[1]) >= 1):
            return yaml.load(f, Loader=yaml.FullLoader)
        return yaml.load(f)


def rangeexpand(txt):
    lst = []
    for r in txt.split(','):
        zlen = len(str(r).split('-')[0])
        lstlen_0 = len(lst)
        if '-' in r[1:]:
            r0, r1 = r[1:].split('-', 1)
            lst += range(int(r[0] + r0), int(r1) + 1)
        else:
            lst.append(int(r))
        lstlen_1 = len(lst)
        for i in range(lstlen_0, lstlen_1):
            lst[i] = str(lst[i]).zfill(zlen)
    return lst


def nodesetexpand(znodeset):
    nodeset = []
    for n in znodeset.split(','):
        if '[' in n and ']' in n:
            n1 = n.split('[')[0]
            n3 = n.split(']')[1]
            for nn in rangeexpand(n.replace(n1 + '[', '').replace(']' + n3, '')):
                nodeset.append(n1 + nn + n3)
        else:
            nodeset.append(n)
    return nodeset


def daemon_set_boot(node, label):
    """Call the pxe-stack-daemon to set menu-default for a node. Verbose on failure."""
    url = '{}/host/{}?menu-default={}'.format(DAEMON_URL, node, label)
    logging.info('    ├── ' + bcolors.OKBLUE + 'Calling daemon: GET ' + url + bcolors.ENDC)
    try:
        req = urllib.request.Request(url, method='GET')
        with urllib.request.urlopen(req, timeout=DAEMON_TIMEOUT) as resp:
            body = resp.read().decode('utf-8').strip()
            logging.info('    └── ' + bcolors.OKGREEN + '[OK] Daemon confirmed: ' + body + bcolors.ENDC)
            return True
    except urllib.error.HTTPError as e:
        body = e.read().decode('utf-8').strip()
        logging.error(bcolors.FAIL + '    └── [ERROR] Daemon rejected request (HTTP {}): {}'.format(e.code, body) + bcolors.ENDC)
        return False
    except urllib.error.URLError as e:
        logging.error(bcolors.FAIL + '    └── [ERROR] Could not reach bluebanquise-pxe-stack-daemon: {}'.format(e) + bcolors.ENDC)
        _print_daemon_hint()
        return False
    except Exception as e:
        logging.error(bcolors.FAIL + '    └── [ERROR] Unexpected error contacting daemon: {}'.format(e) + bcolors.ENDC)
        _print_daemon_hint()
        return False


def _print_daemon_hint():
    print('')
    print(bcolors.WARNING + '  ┌─────────────────────────────────────────────────────────┐' + bcolors.ENDC)
    print(bcolors.WARNING + '  │  bluebanquise-pxe-stack-daemon is not responding.        │' + bcolors.ENDC)
    print(bcolors.WARNING + '  │                                                          │' + bcolors.ENDC)
    print(bcolors.WARNING + '  │  Check daemon status:                                    │' + bcolors.ENDC)
    print(bcolors.WARNING + '  │    systemctl status bluebanquise-pxe-stack-daemon         │' + bcolors.ENDC)
    print(bcolors.WARNING + '  │                                                          │' + bcolors.ENDC)
    print(bcolors.WARNING + '  │  View daemon logs:                                       │' + bcolors.ENDC)
    print(bcolors.WARNING + '  │    journalctl -u bluebanquise-pxe-stack-daemon -f         │' + bcolors.ENDC)
    print(bcolors.WARNING + '  │                                                          │' + bcolors.ENDC)
    print(bcolors.WARNING + '  │  Start daemon if not running:                            │' + bcolors.ENDC)
    print(bcolors.WARNING + '  │    systemctl start bluebanquise-pxe-stack-daemon          │' + bcolors.ENDC)
    print(bcolors.WARNING + '  └─────────────────────────────────────────────────────────┘' + bcolors.ENDC)
    print('')


def read_host_state(base_path, node):
    """Read dynamic_pxe_stack.yml for a node. Returns dict or None."""
    state_file = os.path.join(base_path, node, 'dynamic_pxe_stack.yml')
    if not os.path.exists(state_file):
        return None
    with open(state_file, 'r') as f:
        return yaml.safe_load(f) or {}


# ─── argument parsing ─────────────────────────────────────────────────────────

parser = ArgumentParser()
parser.add_argument("-n", "--nodes", dest="nodes", required=True,
                    help="Target node(s). Use nodeset format for ranges.", metavar="NODE")
parser.add_argument("-s", "--status", dest="status", action="store_true",
                    help="Display current nodes boot target status.")
parser.add_argument("-b", "--boot", dest="boot", choices=BOOT_OPTIONS,
                    help="Next pxe boot: can be {}.".format(', '.join(BOOT_OPTIONS)))
parser.add_argument("-i", "--image", dest="image", default="none",
                    help="Specify diskless or clone image to be used.")
parser.add_argument("-e", "--extra-parameters", dest="extra_parameters", default="none",
                    help="Add extra parameters for boot chain.")
parser.add_argument("-q", "--quiet", action="store_true",
                    help="Do not print INFO messages.")

if len(sys.argv) == 1:
    parser.print_help()
    sys.exit(1)

passed_arguments = parser.parse_args()

if not any([passed_arguments.status, passed_arguments.boot]):
    parser.error(bcolors.FAIL + "At least one of --status or --boot must be provided." + bcolors.ENDC)

print("""\

                (o_
      (o_  (o_  //\\
      (/)_ (/)_ V_/_

   BlueBanquise bootset
   v2.0.0
   https://github.com/bluebanquise/bluebanquise/

""")

loglevel = logging.INFO
if passed_arguments.quiet:
    loglevel = logging.WARNING
logging.basicConfig(format='[%(levelname)s] %(message)s', level=loglevel)

# Load configuration
pxe_parameters = load_file('/etc/bluebanquise/bootset/pxe_parameters.yml')

cluster_base_path = pxe_parameters.get('pxe_parameters', {}).get(
    'cluster_base_path', '/var/lib/bluebanquise/cluster/hosts')

# Load tenants only if exists
tenants = {}
if os.path.exists('/etc/bluebanquise/bootset/tenants.yml'):
    tenants = load_file('/etc/bluebanquise/bootset/tenants.yml')

# ─── status ───────────────────────────────────────────────────────────────────

if passed_arguments.status:
    by_boot = {}
    unknown = []

    for node in nodesetexpand(passed_arguments.nodes):
        state = read_host_state(cluster_base_path, node)
        if state is None:
            logging.warning(bcolors.WARNING + 'No state file for ' + node + '. Run pxe_stack role or bootset --boot first.' + bcolors.ENDC)
            unknown.append(node)
            continue

        label = state.get('menu_default', 'bootdisk')
        prov_status = state.get('provisioning_status') or 'NA'

        display = '{} [provisioning: {}]'.format(label, prov_status)

        if label not in by_boot:
            by_boot[label] = []
        by_boot[label].append((node, display))

    for label, nodes in sorted(by_boot.items()):
        print('menu-default={} :'.format(label))
        for node, display in nodes:
            print('  {}'.format(display.replace(label + ' ', '')))
        print()
    if unknown:
        print('No state file: {}'.format(', '.join(unknown)))

# ─── boot ─────────────────────────────────────────────────────────────────────

elif passed_arguments.boot:
    label = BOOT_LABELS[passed_arguments.boot]

    for node in nodesetexpand(passed_arguments.nodes):
        logging.info(bcolors.OKBLUE + 'Processing node ' + str(node) + ' ...' + bcolors.ENDC)
        logging.info('    ├── ' + bcolors.OKBLUE + 'Setting menu-default=' + label + bcolors.ENDC)
        daemon_set_boot(node=node, label=label)
