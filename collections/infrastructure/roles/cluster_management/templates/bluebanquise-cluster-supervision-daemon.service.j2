{{ ansible_managed | comment }}
[Unit]
Description=BlueBanquise Cluster Supervision Daemon
After=network.target

[Service]
Type=simple
User=bluebanquise
Group=bluebanquise
ExecStart={{ cluster_management_supervision_daemon_script_path }} {{ cluster_management_supervision_daemon_conf_path }}
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
