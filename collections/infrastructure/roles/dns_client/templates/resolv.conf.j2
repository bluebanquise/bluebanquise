#jinja2: lstrip_blocks: True
#### Blue Banquise file ####
## {{ ansible_managed }}

{% set nameservers = [] %}
{% set node_main_network = network_interfaces | default([]) | selectattr('network','defined') | selectattr('interface','defined') | selectattr('ip4','defined') | selectattr('network','match','^net-[a-zA-Z0-9]+') | map(attribute='network') | list | first | default(none) %}

{% if dns_client_servers is defined and dns_client_servers is iterable %}
  {% for dns in dns_client_servers %}
    {% set _ = nameservers.append(dns) %}
  {% endfor %}
{% elif node_main_network is not none %}
  {% if networks[node_main_network]['services'] is defined and networks[node_main_network]['services'] is iterable and networks[node_main_network]['services'] is not string and networks[node_main_network]['services'] is mapping %}
    {% set dns_services = networks[node_main_network]['services']['dns4'] | default(networks[node_main_network]['services']['dns'] | default(none), true) %}
    {% if dns_services is defined and dns_services is iterable and dns_services is not string and dns_services is not mapping %}
      {% for elem in dns_services %}
        {% if elem.ip4 is defined and (elem.ip4 | ansible.utils.ipaddr) %}
          {% set _ = nameservers.append(elem.ip4) %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endif %}
  {% if nameservers | length == 0 and networks[node_main_network]['services_ip'] is defined and (networks[node_main_network]['services_ip'] | ansible.utils.ipaddr) %}
    {% set _ = nameservers.append(networks[node_main_network]['services_ip']) %}
  {% endif %}
{% endif %}

search {{ dns_client_domain_name | default(bb_domain_name, true) | default('cluster.local', true) }}
{% for nameserver in nameservers %}
nameserver {{ nameserver }}
{% endfor %}
{% if dns_client_external_servers is defined and dns_client_external_servers is iterable %}
  {% for external_dns in dns_client_external_servers %}
nameserver {{ external_dns }}
  {% endfor %}
{% endif %}
