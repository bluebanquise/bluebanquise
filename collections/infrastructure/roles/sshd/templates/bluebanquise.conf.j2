{{ ansible_managed | comment }}
{# YAML booleans (yes/no without quotes) are written as yes/no #}
{% macro value(setting) %}{{ 'yes' if setting is sameas true else ('no' if setting is sameas false else setting) }}{% endmacro %}

{% if sshd_raw is defined and sshd_raw is not none %}
{{ sshd_raw }}

{% endif %}
{% if sshd_permitrootlogin is defined and sshd_permitrootlogin is not none %}
PermitRootLogin {{ value(sshd_permitrootlogin) }}
{% endif %}
{% if sshd_passwordauthentication is defined and sshd_passwordauthentication is not none %}
PasswordAuthentication {{ value(sshd_passwordauthentication) }}
{% endif %}
{% if sshd_denyusers is defined and sshd_denyusers is not none %}
DenyUsers {{ sshd_denyusers }}
{% endif %}
{% if sshd_allowusers is defined and sshd_allowusers is not none %}
AllowUsers {{ sshd_allowusers }}
{% endif %}
{% if sshd_denygroups is defined and sshd_denygroups is not none %}
DenyGroups {{ sshd_denygroups }}
{% endif %}
{% if sshd_allowgroups is defined and sshd_allowgroups is not none %}
AllowGroups {{ sshd_allowgroups }}
{% endif %}
