{{ ansible_managed | comment }}
# Loki single process, filesystem storage
# https://grafana.com/docs/loki/latest/configure/

auth_enabled: false

server:
  http_listen_address: {{ loki_ip }}
  http_listen_port: {{ loki_port }}
  grpc_listen_address: 127.0.0.1
  grpc_listen_port: {{ loki_grpc_port }}
  log_level: warn

common:
  instance_addr: 127.0.0.1
  path_prefix: {{ loki_data_dir }}
  storage:
    filesystem:
      # Not chunks/, used by Loki 2 (role versions 1.x) with a format Loki 3 cannot read
      chunks_directory: {{ loki_data_dir }}/storage/chunks
      rules_directory: {{ loki_data_dir }}/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  reject_old_samples: true
  reject_old_samples_max_age: 168h
  retention_period: {{ loki_retention_period }}

compactor:
  working_directory: {{ loki_data_dir }}/compactor
  retention_enabled: {{ (loki_retention_period != '0s') | lower }}
  delete_request_store: filesystem

analytics:
  reporting_enabled: false
