#jinja2: lstrip_blocks: True
{{ ansible_managed | comment }}

include "/etc/powerman/ipmipower.dev"

{# Gather hosts having a BMC and IPMI credentials #}
{% set ns = namespace(bmc_hosts=[]) %}
{% for host in groups[powerman_restrict_to_group | default(bb_restrict_to_group, true) | default('all', true)] | sort %}
  {% set ipmi_authentication = hostvars[host]['hw_board_authentication'] | default([], true) | selectattr('protocol', 'defined') | selectattr('protocol', 'match', 'IPMI') | list %}
  {% if hostvars[host]['bmc']['name'] is defined and ipmi_authentication | length > 0 %}
    {% set ns.bmc_hosts = ns.bmc_hosts + [{'host': host, 'bmc': hostvars[host]['bmc']['name'], 'credentials': [ipmi_authentication[0]['user'], ipmi_authentication[0]['password']]}] %}
  {% endif %}
{% endfor %}
{# One ipmipower device per set of credentials #}
{% for credentials, bmc_hosts in ns.bmc_hosts | groupby('credentials') %}
  {% set device = 'ipmi' ~ loop.index %}
device "{{ device }}" "ipmipower" "/usr/sbin/ipmipower --wait-until-on --wait-until-off -h {{ bmc_hosts | map(attribute='bmc') | bluebanquise.infrastructure.nodeset }} -u {{ credentials[0] }} -p {{ credentials[1] }}{{ ' -D LAN_2_0' if powerman_enable_ipmi_lan_2_0 | bool else '' }} |&"
  {% for bmc_host in bmc_hosts %}
node "{{ bmc_host['host'] }}" "{{ device }}" "{{ bmc_host['bmc'] }}"
  {% endfor %}
{% endfor %}
