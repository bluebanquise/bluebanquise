#jinja2: lstrip_blocks: True
#### Blue Banquise file ####
## {{ ansible_managed }}

127.0.0.1   localhost localhost.localdomain localhost4 localhost4.localdomain4
::1         localhost localhost.localdomain localhost6 localhost6.localdomain6

{% set domain = hosts_file_domain_name | default(bb_domain_name, true) | default('cluster.local', true) %}
{# Base records: first interface of each host, host aliases, BMCs and network services #}
{% set records = hosts_file_hosts['forward']['base'] %}
{# Extended records: hostname-network of each interface, and interfaces aliases #}
{% if hosts_file_enable_extended_names | bool %}
{%   set records = records + hosts_file_hosts['forward']['extended'] %}
{% endif %}
## Internal hosts

{% for host in records %}
{%   if hosts_file_fqdn_first | bool %}
{{ host.ip4 }} {{ host.hostname }}.{{ domain }} {{ host.hostname }}
{%   else %}
{{ host.ip4 }} {{ host.hostname }} {{ host.hostname }}.{{ domain }}
{%   endif %}
{% endfor %}

## External hosts

{% for host in (hosts_file_external_hosts | sort) %}
{%   if hosts_file_external_hosts[host] is mapping %}
{{ hosts_file_external_hosts[host]['ip4'] }} {{ host }} {{ hosts_file_external_hosts[host]['alias'] | default([], true) | join(' ') }}
{%   else %}
{{ hosts_file_external_hosts[host] }} {{ host }}
{%   endif %}
{% endfor %}
