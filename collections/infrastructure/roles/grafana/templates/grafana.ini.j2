{{ ansible_managed | comment }}
# https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/
# Strings are triple quoted, so that # and ; are not read as comments.
{% for section, options in grafana_ini.items() %}

[{{ section }}]
{%   for key, value in options.items() %}
{%     if value is boolean %}
{{ key }} = {{ value | lower }}
{%     elif value is string %}
{{ key }} = """{{ value }}"""
{%     else %}
{{ key }} = {{ value }}
{%     endif %}
{%   endfor %}
{% endfor %}
