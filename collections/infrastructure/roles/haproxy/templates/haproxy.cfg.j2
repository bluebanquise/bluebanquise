#jinja2: lstrip_blocks: True
{{ ansible_managed | comment }}

global
{% if haproxy_global_parameters | default('', true) | length > 0 %}
{{ haproxy_global_parameters | trim | indent(4, true) }}
{% else %}
    # BlueBanquise role defaults
    log stdout format raw local0
    user haproxy
    group haproxy
    chroot /var/lib/haproxy
    stats socket /var/lib/haproxy/stats user haproxy group haproxy mode 660 level admin
    nbthread 4
    maxconn 50000
{% endif %}

defaults
{% if haproxy_defaults_parameters | default('', true) | length > 0 %}
{{ haproxy_defaults_parameters | trim | indent(4, true) }}
{% else %}
    # BlueBanquise role defaults
    timeout connect 10s
    timeout client 30s
    timeout server 30s
    log global
    mode http
    option httplog
    maxconn 5000
{% endif %}
{% if haproxy_resources_raw | default('', true) | length > 0 %}

{{ haproxy_resources_raw }}
{% endif %}
{% for resource in haproxy_resources %}

{%   if resource.type == 'http_simple' or resource.type == 'http_load_balancer' %}
# {{ resource.type }} - {{ resource.name }}
frontend {{ resource.name }}-frontend
    mode http
    bind {{ resource.bind.ip4 | default('') }}:{{ resource.bind.port }}
    default_backend {{ resource.name }}-backend

backend {{ resource.name }}-backend
    mode http
    balance roundrobin
{%     for server in resource.servers %}
{%       if server.port is defined and server.port is not none %}
{%         set server_address = server.ip4 ~ ':' ~ server.port %}
{%       else %}
{%         set server_address = server.ip4 %}
{%       endif %}
{%       if resource.type == 'http_simple' %}
    server {{ server.hostname }} {{ server_address }} check
{%       else %}
    server {{ server.hostname }} {{ server_address }} check redir http://{{ server_address }}
{%       endif %}
{%     endfor %}
{%   elif resource.type == 'frontend' %}
# frontend - {{ resource.name }}
frontend {{ resource.name }}
{%     if resource.parameters | default('', true) | length > 0 %}
{{ resource.parameters | trim | indent(4, true) }}
{%     endif %}
    bind {{ resource.bind.ip4 | default('') }}:{{ resource.bind.port }}
    default_backend {{ resource.default_backend }}
{%   elif resource.type == 'backend' %}
# backend - {{ resource.name }}
backend {{ resource.name }}
{%     if resource.parameters | default('', true) | length > 0 %}
{{ resource.parameters | trim | indent(4, true) }}
{%     endif %}
{%     for server in resource.servers %}
    server {{ server.hostname }} {{ server.ip4 }}:{{ server.port }} {{ server.parameters | default('check', true) }}
{%     endfor %}
{%   endif %}
{% endfor %}
