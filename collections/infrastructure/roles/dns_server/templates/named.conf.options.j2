#jinja2: lstrip_blocks: True
#### Blue Banquise file ####
## {{ ansible_managed }}

## Options for BIND9 dns server

options {
  {#
    Listen on DNS services ip of each served network: dns4 (or dns) services, else services_ip.
    Served networks are management networks (net- prefix) without dns_server set to false.
  #}
  listen-on port 53 {
    127.0.0.1;
{% for network_name in (networks | select('match', '^net-') | list | sort) %}
  {% set network = networks[network_name] %}
  {% if network['dns_server'] | default(true) | bool %}
    {% set services = network['services'] | default({}, true) %}
    {% set dns_entries = services['dns4'] | default(services['dns'], true) | default([], true) %}
    {% if dns_entries | length > 0 %}
      {% for entry in dns_entries %}
        {% if entry['ip4'] is defined and entry['ip4'] %}
    {{ entry['ip4'] | ansible.utils.ipaddr('address') }};
        {% endif %}
      {% endfor %}
    {% elif network['services_ip'] is defined and network['services_ip'] %}
    {{ network['services_ip'] }};
    {% endif %}
  {% endif %}
{% endfor %}
{% for listen in dns_server_listen_on_ip4 %}
    {{ listen }};
{% endfor %}
  };

  # listen-on-v6 port 53 { ::1; };  # To be uncommented later if needed
  directory 	"{{ dns_server_var_dir }}";
  dump-file 	"{{ dns_server_dump_file }}";
  statistics-file "{{ dns_server_statistics_file }}";
  memstatistics-file "{{ dns_server_mem_stats_file }}";

  allow-query {
    localhost;
{% for network in (networks | select('match', '^net-') | list | sort) %}
  {% if networks[network]['dns_server'] | default(true) | bool %}
    {{ networks[network]['subnet'] }}/{{ networks[network]['prefix'] }};
  {% endif %}
{% endfor %}
{% for allow_query in dns_server_allow_query %}
    {{ allow_query }};
{% endfor %}
  };

{% if dns_server_recursion %}
  recursion yes;
{% else %}
  recursion no;
{% endif %}

{% if (dns_server_forwarders | length) > 0 %}
  {% if dns_server_forward_only | default(false, true) %}
  forward only;
  {% endif %}
  forwarders {
  {% for forwarder in dns_server_forwarders %}
    {{ forwarder }};
  {% endfor %}
  };
{% endif %}

{% if dns_server_crypto_policy_file is defined %}
  include "{{ dns_server_crypto_policy_file }}";

{% endif %}
  dnssec-validation {{ dns_server_dnssec_validation }};

  managed-keys-directory "{{ dns_server_managed_keys_dir }}";

  pid-file "/run/named/named.pid";
  session-keyfile "/run/named/session.key";

{% if dns_server_overrides is defined %}
  {# qname-wait-recurse no: answer overridden names without waiting for upstream resolution #}
  response-policy { zone "override"; } qname-wait-recurse no;
{% endif %}

{% if dns_server_raw_options_content is defined %}
  ## Raw options content from user
{{ dns_server_raw_options_content | indent(2, true) }}
{% endif %}
};

logging {
  channel default_debug {
    file "{{ dns_server_log_dir }}/named.log";
    severity dynamic;
  };
};
